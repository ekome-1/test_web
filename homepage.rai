int CStatementEnd(array<string> tokens, int start, int tokenCount)
{
    if(start >= tokenCount)
    {
        return tokenCount
    }
    if(tokens[start] == "{")
    {
        int blockDepth = 0
        int blockScan = start
        while(blockScan < tokenCount)
        {
            if(tokens[blockScan] == "{")
            {
                blockDepth = blockDepth + 1
            }
            else if(tokens[blockScan] == "}")
            {
                blockDepth = blockDepth - 1
                if(blockDepth == 0)
                {
                    return blockScan + 1
                }
            }
            blockScan = blockScan + 1
        }
        return tokenCount
    }

    int parentheses = 0
    int brackets = 0
    int braces = 0
    int statementScan = start
    while(statementScan < tokenCount)
    {
        if(tokens[statementScan] == "(")
        {
            parentheses = parentheses + 1
        }
        else if(tokens[statementScan] == ")")
        {
            if(parentheses > 0)
            {
                parentheses = parentheses - 1
            }
        }
        else if(tokens[statementScan] == "[")
        {
            brackets = brackets + 1
        }
        else if(tokens[statementScan] == "]")
        {
            if(brackets > 0)
            {
                brackets = brackets - 1
            }
        }
        else if(tokens[statementScan] == "{")
        {
            braces = braces + 1
        }
        else if(tokens[statementScan] == "}")
        {
            if(braces > 0)
            {
                braces = braces - 1
                if(braces == 0 && parentheses == 0 && brackets == 0)
                {
                    if(statementScan + 1 < tokenCount && tokens[statementScan + 1] == "else")
                    {
                        statementScan = statementScan + 1
                        continue
                    }
                    return statementScan + 1
                }
            }
        }
        else if(tokens[statementScan] == ";" && parentheses == 0 && brackets == 0 && braces == 0)
        {
            return statementScan + 1
        }
        statementScan = statementScan + 1
    }
    return tokenCount
}

string CParameterName(array<string> tokens, int start, int end)
{
    int parameterToken = end - 1
    while(parameterToken >= start && (tokens[parameterToken] == "*" || tokens[parameterToken] == "&" || tokens[parameterToken] == "[" || tokens[parameterToken] == "]" || tokens[parameterToken] == "const" || tokens[parameterToken] == "volatile"))
    {
        parameterToken = parameterToken - 1
    }
    if(parameterToken >= start && tokens[parameterToken] != "void")
    {
        return tokens[parameterToken]
    }
    return ""
}

int IsPointerParameterReturned(string functionName, int requestedParameter, int tokenCount, array<string> tokens, array<int> tokenScopes)
{
    int functionIndex = 0
    while(functionIndex < tokenCount)
    {
        if(tokenScopes[functionIndex] == 0 && tokens[functionIndex] == functionName && functionIndex + 2 < tokenCount && tokens[functionIndex + 1] == "(")
        {
            int functionScan = functionIndex + 1
            int functionParenDepth = 0
            int functionCloseParen = tokenCount
            bool functionParamsEnded = false
            while(functionScan < tokenCount && !functionParamsEnded)
            {
                if(tokens[functionScan] == "(")
                {
                    functionParenDepth = functionParenDepth + 1
                }
                else if(tokens[functionScan] == ")")
                {
                    functionParenDepth = functionParenDepth - 1
                    if(functionParenDepth == 0)
                    {
                        functionCloseParen = functionScan
                        functionParamsEnded = true
                    }
                }
                functionScan = functionScan + 1
            }
            if(functionParamsEnded && functionCloseParen + 1 < tokenCount && tokens[functionCloseParen + 1] == "{")
            {
                string returnedParameterName = ""
                int parameterStart = functionIndex + 2
                int parameterDepth = 0
                int parameterIndex = 0
                int parameterScan = parameterStart
                while(parameterScan <= functionCloseParen)
                {
                    if(tokens[parameterScan] == "(" || tokens[parameterScan] == "[")
                    {
                        parameterDepth = parameterDepth + 1
                    }
                    else if(tokens[parameterScan] == ")" || tokens[parameterScan] == "]")
                    {
                        if(parameterDepth > 0)
                        {
                            parameterDepth = parameterDepth - 1
                        }
                    }
                    if((tokens[parameterScan] == "," && parameterDepth == 0) || parameterScan == functionCloseParen)
                    {
                        CParameterName(tokens, parameterStart, parameterScan)
                        string parameterName = CParameterName
                        if(parameterIndex == requestedParameter)
                        {
                            returnedParameterName = parameterName
                        }
                        parameterIndex = parameterIndex + 1
                        parameterStart = parameterScan + 1
                    }
                    parameterScan = parameterScan + 1
                }
                if(returnedParameterName != "")
                {
                    CStatementEnd(tokens, functionCloseParen + 1, tokenCount)
                    int functionBodyEnd = CStatementEnd
                    int functionScope = tokenScopes[functionCloseParen + 1]
                    array<string> returnAliasNames = array<string>{}
                    array<int> returnAliasScopes = array<int>{}
                    array<bool> returnAliasActive = array<bool>{}
                    int returnScan = functionCloseParen + 2
                    while(returnScan < functionBodyEnd)
                    {
                        if(tokens[returnScan] == "=" && returnScan > 0 && returnScan + 1 < functionBodyEnd)
                        {
                            string returnTargetName = tokens[returnScan - 1]
                            bool returnTargetIsMember = false
                            if(returnScan >= 3 && tokens[returnScan - 2] == ".")
                            {
                                returnTargetName = tokens[returnScan - 3]
                                returnTargetIsMember = true
                            }
                            else if(returnScan >= 4 && tokens[returnScan - 2] == ">" && tokens[returnScan - 3] == "-")
                            {
                                returnTargetName = tokens[returnScan - 4]
                                returnTargetIsMember = true
                            }
                            bool returnSourceCarriesParameter = tokens[returnScan + 1] == returnedParameterName
                            Length(returnAliasNames)
                            int returnAliasCount = Length
                            for(returnAliasIndex, 0, returnAliasCount)
                            {
                                if(returnAliasActive[returnAliasIndex] && tokens[returnScan + 1] == returnAliasNames[returnAliasIndex] && returnAliasScopes[returnAliasIndex] <= tokenScopes[returnScan])
                                {
                                    returnSourceCarriesParameter = true
                                }
                            }
                            if(returnSourceCarriesParameter && !returnTargetIsMember && returnTargetName != "*" && returnTargetName != "&" && tokenScopes[returnScan - 1] >= functionScope)
                            {
                                bool knownReturnAlias = false
                                for(returnAliasCheck, 0, returnAliasCount)
                                {
                                    if(returnAliasNames[returnAliasCheck] == returnTargetName && returnAliasScopes[returnAliasCheck] == tokenScopes[returnScan - 1])
                                    {
                                        returnAliasActive[returnAliasCheck] = true
                                        knownReturnAlias = true
                                    }
                                }
                                if(!knownReturnAlias)
                                {
                                    add(returnAliasNames, returnTargetName)
                                    add(returnAliasScopes, tokenScopes[returnScan - 1])
                                    add(returnAliasActive, true)
                                }
                            }
                            else if(!returnTargetIsMember && returnTargetName != "*" && returnTargetName != "&")
                            {
                                for(returnAliasClear, 0, returnAliasCount)
                                {
                                    if(returnAliasNames[returnAliasClear] == returnTargetName && returnAliasScopes[returnAliasClear] == tokenScopes[returnScan - 1])
                                    {
                                        returnAliasActive[returnAliasClear] = false
                                    }
                                }
                            }
                        }
                        if(tokens[returnScan] == "return" && returnScan + 2 < functionBodyEnd && tokens[returnScan + 2] == ";")
                        {
                            if(tokens[returnScan + 1] == returnedParameterName)
                            {
                                return 1
                            }
                            Length(returnAliasNames)
                            int returnAliasCountForReturn = Length
                            for(returnAliasReturnIndex, 0, returnAliasCountForReturn)
                            {
                                if(returnAliasActive[returnAliasReturnIndex] && tokens[returnScan + 1] == returnAliasNames[returnAliasReturnIndex] && returnAliasScopes[returnAliasReturnIndex] <= tokenScopes[returnScan])
                                {
                                    return 1
                                }
                            }
                        }
                        returnScan = returnScan + 1
                    }
                }
            }
        }
        functionIndex = functionIndex + 1
    }
    return 0
}

int IsGlobalStorageTarget(string targetName, int before, int scope, array<string> tokens, array<int> tokenScopes)
{
    int scan = before - 1
    while(scan >= 2)
    {
        if(tokens[scan] == targetName && (tokenScopes[scan] == 0 || tokenScopes[scan] == scope) && scan + 1 < before && (tokens[scan + 1] == ";" || tokens[scan + 1] == "="))
        {
            if(tokenScopes[scan] == 0)
            {
                return 1
            }
            return 0
        }
        scan = scan - 1
    }
    return 0
}

int IsPointerParameterStoredGlobally(string functionName, int requestedParameter, int tokenCount, array<string> tokens, array<int> tokenScopes)
{
    int functionIndex = 0
    while(functionIndex < tokenCount)
