}

int ResolvePointerCandidate(string pointerName, int functionScope, int beforeToken, int currentLexicalScope, int currentBranch, int currentArm, int maximumDistance, array<string> allocationNames, array<int> allocationFunctionScopes, array<int> allocationTokens, array<int> allocationLexicalScopes, array<string> aliasNames, array<int> aliasCandidates, array<int> aliasFunctionScopes, array<int> aliasLexicalScopes, array<int> aliasBranches, array<int> aliasArms, array<bool> aliasActive, array<int> lexicalScopeParents, array<int> branchParents, array<int> branchParentArms)
{
    GetNearestAllocationDistance(pointerName, functionScope, beforeToken, currentLexicalScope, maximumDistance, allocationNames, allocationFunctionScopes, allocationTokens, allocationLexicalScopes, lexicalScopeParents)
    int nearestAllocationDistance = GetNearestAllocationDistance
    int nearestAliasDistance = maximumDistance
    Length(aliasNames)
    int aliasCount = Length
    for(aliasIndex, 0, aliasCount)
    {
        if(aliasActive[aliasIndex] && aliasNames[aliasIndex] == pointerName && aliasFunctionScopes[aliasIndex] == functionScope)
        {
            GetLexicalScopeDistance(currentLexicalScope, aliasLexicalScopes[aliasIndex], lexicalScopeParents)
            int aliasDistance = GetLexicalScopeDistance
            IsBranchContextWithin(currentBranch, currentArm, aliasBranches[aliasIndex], aliasArms[aliasIndex], branchParents, branchParentArms)
            int aliasPathMatches = IsBranchContextWithin
            if(aliasDistance >= 0 && aliasPathMatches == 1 && aliasDistance < nearestAliasDistance)
            {
                nearestAliasDistance = aliasDistance
            }
        }
    }

    if(nearestAliasDistance <= nearestAllocationDistance)
    {
        for(aliasIndex, 0, aliasCount)
        {
            if(aliasActive[aliasIndex] && aliasNames[aliasIndex] == pointerName && aliasFunctionScopes[aliasIndex] == functionScope && aliasCandidates[aliasIndex] >= 0)
            {
                GetLexicalScopeDistance(currentLexicalScope, aliasLexicalScopes[aliasIndex], lexicalScopeParents)
                int aliasDistance = GetLexicalScopeDistance
                IsBranchContextWithin(currentBranch, currentArm, aliasBranches[aliasIndex], aliasArms[aliasIndex], branchParents, branchParentArms)
                int aliasPathMatches = IsBranchContextWithin
                if(aliasDistance == nearestAliasDistance && aliasPathMatches == 1)
                {
                    return aliasCandidates[aliasIndex]
                }
            }
        }
    }

    if(nearestAllocationDistance <= maximumDistance)
    {
        Length(allocationNames)
        int candidateCount = Length
        int resolvedAllocationCandidate = -1
        int resolvedAllocationToken = -1
        for(candidateIndex, 0, candidateCount)
        {
            if(allocationNames[candidateIndex] == pointerName && allocationFunctionScopes[candidateIndex] == functionScope && allocationTokens[candidateIndex] < beforeToken)
            {
                GetLexicalScopeDistance(currentLexicalScope, allocationLexicalScopes[candidateIndex], lexicalScopeParents)
                int candidateDistance = GetLexicalScopeDistance
                if(candidateDistance == nearestAllocationDistance && allocationTokens[candidateIndex] > resolvedAllocationToken)
                {
                    resolvedAllocationCandidate = candidateIndex
                    resolvedAllocationToken = allocationTokens[candidateIndex]
                }
            }
        }
        if(resolvedAllocationCandidate >= 0)
        {
            return resolvedAllocationCandidate
        }
    }
    return -1
}

int GetReleasedCandidateAtToken(string pointerName, int freeToken, array<int> releasedAllocationTokens, array<int> releasedAllocationIndexes, array<string> releasedThroughNames)
{
    Length(releasedAllocationTokens)
    int releasedCount = Length
    for(releasedIndex, 0, releasedCount)
    {
        if(releasedAllocationTokens[releasedIndex] == freeToken && releasedThroughNames[releasedIndex] == pointerName)
        {
            return releasedAllocationIndexes[releasedIndex]
        }
    }
    return -1
}

int IsDirectAllocationBinding(string pointerName, int functionScope, int beforeToken, int currentLexicalScope, int maximumDistance, array<string> allocationNames, array<int> allocationFunctionScopes, array<int> allocationTokens, array<int> allocationLexicalScopes, array<string> aliasNames, array<int> aliasFunctionScopes, array<int> aliasLexicalScopes, array<bool> aliasActive, array<int> lexicalScopeParents)
{
    GetNearestAllocationDistance(pointerName, functionScope, beforeToken, currentLexicalScope, maximumDistance, allocationNames, allocationFunctionScopes, allocationTokens, allocationLexicalScopes, lexicalScopeParents)
    int directDistance = GetNearestAllocationDistance
    GetNearestAliasDistance(pointerName, functionScope, currentLexicalScope, maximumDistance, aliasNames, aliasFunctionScopes, aliasLexicalScopes, aliasActive, lexicalScopeParents)
    int aliasDistance = GetNearestAliasDistance
    if(directDistance <= maximumDistance && directDistance < aliasDistance)
    {
        return 1
    }
    return 0
}

int IsCandidateReleased(int candidateIndex, int tokenLimit, array<int> allocationTokens, array<int> releaseCandidates, array<int> releaseTokens, array<int> releaseBranches, array<int> releaseArms, array<int> tokenLoops, array<int> tokenBranches, array<int> tokenArms, array<int> branchIfTokens, array<int> branchElseEnds, array<bool> branchHasElse, array<int> branchParents, array<int> branchParentArms)
{
    int allocationToken = allocationTokens[candidateIndex]
    if(tokenLimit <= allocationToken)
    {
        return 0
    }

    Length(branchIfTokens)
    int branchCount = Length
    Length(releaseCandidates)
    int releaseCount = Length
    if(releaseCount == 0)
    {
        return 0
    }
    array<bool> thenCovered = array<bool>{}
    array<bool> elseCovered = array<bool>{}
    for(branchIndex, 0, branchCount)
    {
        add(thenCovered, false)
        add(elseCovered, false)
    }

    for(releaseIndex, 0, releaseCount)
    {
        if(releaseCandidates[releaseIndex] == candidateIndex && releaseTokens[releaseIndex] > allocationToken && releaseTokens[releaseIndex] < tokenLimit && tokenLoops[releaseTokens[releaseIndex]] == 0)
        {
            int releaseBranch = releaseBranches[releaseIndex]
            if(releaseBranch == 0)
            {
                return 1
            }
            if(releaseArms[releaseIndex] == 1)
            {
                thenCovered[releaseBranch - 1] = true
            }
            else if(releaseArms[releaseIndex] == 2)
            {
                elseCovered[releaseBranch - 1] = true
            }
        }
    }

    int reverseIndex = branchCount - 1
    while(reverseIndex >= 0)
    {
        int group = reverseIndex + 1
        int parent = branchParents[reverseIndex]

        bool allocationInside = false
        int allocationArm = 0
        int ancestor = tokenBranches[allocationToken]
        int ancestorArm = tokenArms[allocationToken]
        while(ancestor > 0)
        {
            if(ancestor == group)
            {
                allocationInside = true
                allocationArm = ancestorArm
                ancestor = 0
            }
            else
            {
                ancestorArm = branchParentArms[ancestor - 1]
                ancestor = branchParents[ancestor - 1]
            }
        }

        bool guaranteed = false
        if(allocationInside)
        {
            if(allocationArm == 1 && thenCovered[reverseIndex])
            {
                guaranteed = true
            }
            else if(allocationArm == 2 && elseCovered[reverseIndex])
            {
                guaranteed = true
            }
        }
        else if(allocationToken < branchIfTokens[reverseIndex] && branchHasElse[reverseIndex] && branchElseEnds[reverseIndex] > 0 && branchElseEnds[reverseIndex] <= tokenLimit && thenCovered[reverseIndex] && elseCovered[reverseIndex])
        {
            guaranteed = true
        }

        if(guaranteed)
        {
            if(parent > 0)
            {
                if(branchParentArms[reverseIndex] == 1)
                {
                    thenCovered[parent - 1] = true
                }
                else if(branchParentArms[reverseIndex] == 2)
                {
                    elseCovered[parent - 1] = true
                }
            }
            else
            {
                return 1
            }
        }
        reverseIndex = reverseIndex - 1
    }
    return 0
}

int AnalyzeFile(string path, int lineCount)
{
    array<string> tokens = array<string>{}
    array<int> tokenLines = array<int>{}
    array<int> tokenScopes = array<int>{}
    string token = ""
    int tokenLine = 0
    int mode = 0
    bool escaped = false
    bool blockCommentSawStar = false

    for(lineIndex, 0, lineCount)
    {
        Input()
        string sourceLine = Input
        int lineNumber = lineIndex + 1
        Length(sourceLine)
        int sourceLength = Length
        int column = 0
        bool lineContinuation = false
        while(column < sourceLength)
        {
            Substring(sourceLine, column, 1)
            string ch = Substring

            if(ch == "\\" && column + 1 == sourceLength)
            {
                if(mode == 1 && column > 0)
                {
                    Substring(sourceLine, column - 1, 1)
                    if(Substring == "*")
                    {
                        blockCommentSawStar = true
                    }
                }
                lineContinuation = true
                column = column + 1
                continue
            }

            if(mode == 1)
            {
                if(blockCommentSawStar && ch == "/")
                {
                    mode = 0
                    blockCommentSawStar = false
                    column = column + 1
                    continue
                }
                if(ch != "*")
                {
                    blockCommentSawStar = false
                }
                if(ch == "*" && column + 1 < sourceLength)
                {
                    Substring(sourceLine, column, 2)
                    string pair = Substring
                    if(pair == "*/")
                    {
                        mode = 0
                        blockCommentSawStar = false
                        column = column + 1
                    }
                }
                else if(ch == "*" && column + 1 == sourceLength)
                {
                    blockCommentSawStar = true
                }
                column = column + 1
                continue
            }

            if(mode == 2 || mode == 3)
            {
                if(escaped)
                {
                    escaped = false
                }
                else if(ch == "\\")
                {
                    escaped = true
                }
                else if((mode == 2 && ch == "\"") || (mode == 3 && ch == "'"))
                {
                    add(tokens, token)
                    add(tokenLines, tokenLine)
                    token = ""
                    mode = 0
                }
                column = column + 1
                continue
            }

            if(mode == 4)
            {
                column = sourceLength
                continue
            }

            if(ch == "/" && column + 1 < sourceLength)
            {
                Substring(sourceLine, column, 2)
                string pair = Substring
                if(pair == "//" || pair == "/*")
                {
                    if(token != "")
                    {
                        add(tokens, token)
                        add(tokenLines, tokenLine)
                        token = ""
                    }
                    if(pair == "//")
                    {
                        mode = 4
                    }
                    else
                    {
                        mode = 1
                    }
                    column = column + 2
                    continue
                }
            }

            if(ch == "\"" || ch == "'")
            {
                if(token != "")
                {
                    add(tokens, token)
                    add(tokenLines, tokenLine)
                    token = ""
                }
                if(ch == "\"")
                {
                    token = "__string_literal__"
                    mode = 2
                }
                else
                {
                    token = "__char_literal__"
                    mode = 3
                }
                tokenLine = lineNumber
                escaped = false
                column = column + 1
                continue
            }

            if(ch == " " || ch == "\t" || ch == "\r" || ch == "\n")
            {
                if(token != "")
                {
                    add(tokens, token)
                    add(tokenLines, tokenLine)
                    token = ""
                }
                column = column + 1
                continue
            }

            if(ch == "(" || ch == ")" || ch == "{" || ch == "}" || ch == "[" || ch == "]" || ch == "," || ch == ";" || ch == "=" || ch == "+" || ch == "-" || ch == "*" || ch == "&" || ch == "|" || ch == "!" || ch == "%" || ch == "<" || ch == ">" || ch == "?" || ch == "~" || ch == "^" || ch == ":" || ch == "." || ch == "#")
            {
                if(token != "")
                {
                    add(tokens, token)
                    add(tokenLines, tokenLine)
                    token = ""
                }
                add(tokens, ch)
                add(tokenLines, lineNumber)
                column = column + 1
                continue
            }

            if(token == "")
            {
                tokenLine = lineNumber
            }
            token = token + ch
            column = column + 1
        }

        if(token != "" && !lineContinuation)
        {
            add(tokens, token)
            add(tokenLines, tokenLine)
            token = ""
        }
        if(mode == 4 && !lineContinuation)
        {
            mode = 0
        }
    }

    Length(tokens)
    int tokenCount = Length
    int scopeDepth = 0
    int currentScope = 0
    int nextScope = 0
    for(scopeIndex, 0, tokenCount)
    {
        if(tokens[scopeIndex] == "{")
        {
            if(scopeDepth == 0)
            {
                nextScope = nextScope + 1
                currentScope = nextScope
            }
            scopeDepth = scopeDepth + 1
            add(tokenScopes, currentScope)
        }
        else if(tokens[scopeIndex] == "}")
        {
            add(tokenScopes, currentScope)
            if(scopeDepth > 0)
            {
                scopeDepth = scopeDepth - 1
                if(scopeDepth == 0)
                {
                    currentScope = 0
                }
            }
        }
        else
        {
            add(tokenScopes, currentScope)
        }
    }

    array<int> tokenLexicalScopes = array<int>{}
    array<int> lexicalScopeParents = array<int>{}
    array<int> lexicalScopeStack = array<int>{}
    for(scopeStackInit, 0, tokenCount + 1)
    {
        add(lexicalScopeStack, 0)
    }
    int lexicalDepth = 0
    int lexicalScope = 0
    int nextLexicalScope = 0
    for(lexicalIndex, 0, tokenCount)
    {
        if(tokens[lexicalIndex] == "{")
        {
            nextLexicalScope = nextLexicalScope + 1
            add(lexicalScopeParents, lexicalScope)
            lexicalScopeStack[lexicalDepth] = lexicalScope
            lexicalDepth = lexicalDepth + 1
            lexicalScope = nextLexicalScope
            add(tokenLexicalScopes, lexicalScope)
        }
        else if(tokens[lexicalIndex] == "}")
        {
            add(tokenLexicalScopes, lexicalScope)
            if(lexicalDepth > 0)
            {
                lexicalDepth = lexicalDepth - 1
                lexicalScope = lexicalScopeStack[lexicalDepth]
            }
        }
        else
        {
            add(tokenLexicalScopes, lexicalScope)
        }
    }

    array<int> tokenBranchIDs = array<int>{}
    array<int> tokenBranchArms = array<int>{}
    array<int> tokenLoopIDs = array<int>{}
    array<int> branchIfTokens = array<int>{}
    array<int> branchThenEnds = array<int>{}
    array<int> branchElseEnds = array<int>{}
    array<bool> branchHasElse = array<bool>{}
    array<string> branchNonNullNames = array<string>{}
    array<int> branchNonNullArms = array<int>{}
    array<int> branchParents = array<int>{}
    array<int> branchParentArms = array<int>{}
    array<int> branchStackIDs = array<int>{}
    array<int> branchStackArms = array<int>{}
    array<int> branchStackThenEnds = array<int>{}
    array<int> branchStackElseEnds = array<int>{}
    array<bool> branchStackHasElse = array<bool>{}
    array<int> loopStackIDs = array<int>{}
    array<int> loopStackEnds = array<int>{}
    for(stackInit, 0, tokenCount + 1)
    {
        add(branchStackIDs, 0)
        add(branchStackArms, 0)
        add(branchStackThenEnds, 0)
        add(branchStackElseEnds, 0)
        add(branchStackHasElse, false)
        add(loopStackIDs, 0)
        add(loopStackEnds, 0)
    }
    int branchStackCount = 0
    int loopStackCount = 0
    int nextLoopID = 0
    for(controlIndex, 0, tokenCount)
    {
        bool transitionBranch = true
        while(branchStackCount > 0 && transitionBranch)
        {
            int top = branchStackCount - 1
            if(branchStackArms[top] == 1 && branchStackHasElse[top] && controlIndex == branchStackThenEnds[top])
            {
                branchStackArms[top] = 2
                branchStackThenEnds[top] = branchStackElseEnds[top]
                transitionBranch = false
            }
            else if(controlIndex >= branchStackThenEnds[top])
            {
                branchStackCount = branchStackCount - 1
            }
            else
            {
                transitionBranch = false
            }
        }
        bool popLoop = true
        while(loopStackCount > 0 && popLoop)
        {
            int loopTop = loopStackCount - 1
            if(controlIndex >= loopStackEnds[loopTop])
            {
                loopStackCount = loopStackCount - 1
            }
            else
            {
                popLoop = false
            }
        }

        int currentBranch = 0
        int currentArm = 0
        if(branchStackCount > 0)
        {
            currentBranch = branchStackIDs[branchStackCount - 1]
            currentArm = branchStackArms[branchStackCount - 1]
        }
        int currentLoop = 0
        if(loopStackCount > 0)
        {
            currentLoop = loopStackIDs[loopStackCount - 1]
        }
        add(tokenBranchIDs, currentBranch)
        add(tokenBranchArms, currentArm)
        add(tokenLoopIDs, currentLoop)

        if(tokens[controlIndex] == "if")
        {
            int conditionScan = controlIndex + 1
            int conditionDepth = 0
            bool conditionEnded = false
            int bodyStart = tokenCount
            while(conditionScan < tokenCount && !conditionEnded)
            {
                if(tokens[conditionScan] == "(")
                {
                    conditionDepth = conditionDepth + 1
                }
                else if(tokens[conditionScan] == ")")
                {
                    conditionDepth = conditionDepth - 1
                    if(conditionDepth == 0)
                    {
                        bodyStart = conditionScan + 1
                        conditionEnded = true
                    }
                }
                conditionScan = conditionScan + 1
            }
            int thenEnd = tokenCount
            if(conditionEnded)
            {
                CStatementEnd(tokens, bodyStart, tokenCount)
                thenEnd = CStatementEnd
            }
            bool hasElse = thenEnd < tokenCount && tokens[thenEnd] == "else"
            int elseEnd = 0
            if(hasElse)
            {
                CStatementEnd(tokens, thenEnd + 1, tokenCount)
                elseEnd = CStatementEnd
            }
            Length(branchIfTokens)
            int branchID = Length + 1
            add(branchIfTokens, controlIndex)
            add(branchThenEnds, thenEnd)
            add(branchElseEnds, elseEnd)
            add(branchHasElse, hasElse)
            string nonNullName = ""
            int nonNullArm = 0
            int conditionStart = controlIndex + 2
            int conditionEnd = conditionScan - 2
            if(conditionEnd == conditionStart && tokens[conditionStart] != "!" && tokens[conditionStart] != "0")
            {
                nonNullName = tokens[conditionStart]
                nonNullArm = 1
            }
            else if(conditionEnd == conditionStart + 1 && tokens[conditionStart] == "!" && tokens[conditionStart + 1] != "0")
            {
                nonNullName = tokens[conditionStart + 1]
                nonNullArm = 2
            }
            else if(conditionEnd == conditionStart + 2 && (tokens[conditionStart + 1] == "==" || tokens[conditionStart + 1] == "!=" || tokens[conditionStart + 1] == "="))
            {
                bool comparesNull = tokens[conditionStart + 2] == "NULL" || tokens[conditionStart + 2] == "0"
                if(comparesNull)
                {
                    nonNullName = tokens[conditionStart]
                    if(tokens[conditionStart + 1] == "!=")
                    {
                        nonNullArm = 1
                    }
                    else
                    {
                        nonNullArm = 2
                    }
                }
            }
            else if(conditionEnd == conditionStart + 3 && tokens[conditionStart + 1] == "=" && tokens[conditionStart + 2] == "=" && (tokens[conditionStart + 3] == "NULL" || tokens[conditionStart + 3] == "0"))
            {
                nonNullName = tokens[conditionStart]
                nonNullArm = 2
            }
            else if(conditionEnd == conditionStart + 3 && tokens[conditionStart + 1] == "!" && tokens[conditionStart + 2] == "=" && (tokens[conditionStart + 3] == "NULL" || tokens[conditionStart + 3] == "0"))
            {
                nonNullName = tokens[conditionStart]
                nonNullArm = 1
            }
            else if(conditionEnd == conditionStart + 3 && (tokens[conditionStart] == "NULL" || tokens[conditionStart] == "0") && tokens[conditionStart + 1] == "=" && tokens[conditionStart + 2] == "=" )
            {
                nonNullName = tokens[conditionStart + 3]
                nonNullArm = 2
            }
            else if(conditionEnd == conditionStart + 3 && (tokens[conditionStart] == "NULL" || tokens[conditionStart] == "0") && tokens[conditionStart + 1] == "!" && tokens[conditionStart + 2] == "=" )
            {
                nonNullName = tokens[conditionStart + 3]
                nonNullArm = 1
            }
            else if(conditionEnd == conditionStart + 2 && (tokens[conditionStart] == "NULL" || tokens[conditionStart] == "0") && (tokens[conditionStart + 1] == "==" || tokens[conditionStart + 1] == "!="))
            {
                nonNullName = tokens[conditionStart + 2]
                if(tokens[conditionStart + 1] == "!=")
                {
                    nonNullArm = 1
                }
                else
                {
                    nonNullArm = 2
                }
            }
            add(branchNonNullNames, nonNullName)
            add(branchNonNullArms, nonNullArm)
            int parentID = 0
            int parentArm = 0
            if(branchStackCount > 0)
            {
                parentID = branchStackIDs[branchStackCount - 1]
                parentArm = branchStackArms[branchStackCount - 1]
            }
            add(branchParents, parentID)
            add(branchParentArms, parentArm)
            branchStackIDs[branchStackCount] = branchID
            branchStackArms[branchStackCount] = 1
            branchStackThenEnds[branchStackCount] = thenEnd
            branchStackElseEnds[branchStackCount] = elseEnd
            branchStackHasElse[branchStackCount] = hasElse
            branchStackCount = branchStackCount + 1
        }

        if((tokens[controlIndex] == "for" || tokens[controlIndex] == "while") && !(controlIndex > 0 && tokens[controlIndex] == "while" && tokens[controlIndex - 1] == "}"))
        {
            int loopConditionScan = controlIndex + 1
            int loopConditionDepth = 0
            bool loopConditionEnded = false
            int loopBodyStart = tokenCount
            while(loopConditionScan < tokenCount && !loopConditionEnded)
            {
                if(tokens[loopConditionScan] == "(")
                {
                    loopConditionDepth = loopConditionDepth + 1
                }
                else if(tokens[loopConditionScan] == ")")
                {
                    loopConditionDepth = loopConditionDepth - 1
                    if(loopConditionDepth == 0)
                    {
                        loopBodyStart = loopConditionScan + 1
                        loopConditionEnded = true
                    }
                }
                loopConditionScan = loopConditionScan + 1
            }
            if(loopConditionEnded)
            {
                CStatementEnd(tokens, loopBodyStart, tokenCount)
                int loopEnd = CStatementEnd
                nextLoopID = nextLoopID + 1
                loopStackIDs[loopStackCount] = nextLoopID
                loopStackEnds[loopStackCount] = loopEnd
                loopStackCount = loopStackCount + 1
            }
        }
    }
    array<string> rawReleaseNames = array<string>{}
    array<int> rawReleaseScopes = array<int>{}
    array<int> rawReleaseTokens = array<int>{}
    array<int> rawReleaseBranches = array<int>{}
    array<int> rawReleaseArms = array<int>{}
    array<int> rawReleaseLoops = array<int>{}
    for(rawFreeIndex, 0, tokenCount)
    {
        if(tokens[rawFreeIndex] == "free" && rawFreeIndex + 3 < tokenCount && tokens[rawFreeIndex + 1] == "(" && tokens[rawFreeIndex + 3] == ")")
        {
            add(rawReleaseNames, tokens[rawFreeIndex + 2])
            add(rawReleaseScopes, tokenScopes[rawFreeIndex])
            add(rawReleaseTokens, rawFreeIndex)
            add(rawReleaseBranches, tokenBranchIDs[rawFreeIndex])
            add(rawReleaseArms, tokenBranchArms[rawFreeIndex])
            add(rawReleaseLoops, tokenLoopIDs[rawFreeIndex])
        }
    }
    array<string> releaseFunctionNames = array<string>{}
    array<int> releaseFunctionParameters = array<int>{}
    for(functionIndex, 0, tokenCount)
    {
        if(tokenScopes[functionIndex] == 0 && functionIndex + 2 < tokenCount && tokens[functionIndex + 1] == "(")
        {
            int functionOpenParen = functionIndex + 1
            int functionScan = functionOpenParen
            int functionParenDepth = 0
            int functionCloseParen = tokenCount
            bool functionParamsEnded = false
            while(functionScan < tokenCount && !functionParamsEnded)
            {
                if(tokens[functionScan] == "(")
                {
                    functionParenDepth = functionParenDepth + 1
                }
                else if(tokens[functionScan] == ")")
                {
                    functionParenDepth = functionParenDepth - 1
                    if(functionParenDepth == 0)
                    {
                        functionCloseParen = functionScan
                        functionParamsEnded = true
                    }
                }
                functionScan = functionScan + 1
            }
            if(functionParamsEnded && functionCloseParen + 1 < tokenCount && tokens[functionCloseParen + 1] == "{")
            {
                int functionBodyOpen = functionCloseParen + 1
                int functionScope = tokenScopes[functionBodyOpen]
                CStatementEnd(tokens, functionBodyOpen, tokenCount)
                int functionBodyEnd = CStatementEnd
                int parameterStart = functionOpenParen + 1
                int parameterDepth = 0
                int parameterIndex = 0
                if(parameterStart < functionCloseParen)
                {
                    for(parameterScan, parameterStart, functionCloseParen + 1)
                    {
                        if(tokens[parameterScan] == "(" || tokens[parameterScan] == "[")
                        {
                            parameterDepth = parameterDepth + 1
                        }
                        else if(tokens[parameterScan] == ")" || tokens[parameterScan] == "]")
                        {
                            if(parameterDepth > 0)
                            {
                                parameterDepth = parameterDepth - 1
                            }
                        }
                        if((tokens[parameterScan] == "," && parameterDepth == 0) || parameterScan == functionCloseParen)
                        {
                            CParameterName(tokens, parameterStart, parameterScan)
                            string parameterName = CParameterName
                            if(parameterName != "")
                            {
                                bool releasesParameter = false
                                Length(rawReleaseNames)
                                int rawReleaseCount = Length
                                for(rawCheck, 0, rawReleaseCount)
                                {
                                    if(rawReleaseNames[rawCheck] == parameterName && rawReleaseScopes[rawCheck] == functionScope && rawReleaseTokens[rawCheck] > functionBodyOpen && rawReleaseTokens[rawCheck] < functionBodyEnd && rawReleaseLoops[rawCheck] == 0 && rawReleaseBranches[rawCheck] == 0)
                                    {
                                        releasesParameter = true
                                    }
                                    else if(rawReleaseNames[rawCheck] == parameterName && rawReleaseScopes[rawCheck] == functionScope && rawReleaseTokens[rawCheck] > functionBodyOpen && rawReleaseTokens[rawCheck] < functionBodyEnd && rawReleaseLoops[rawCheck] == 0 && rawReleaseBranches[rawCheck] > 0)
                                    {
                                        int releaseBranch = rawReleaseBranches[rawCheck]
                                        if(branchParents[releaseBranch - 1] == 0 && branchHasElse[releaseBranch - 1])
                                        {
                                            for(oppositeCheck, 0, rawReleaseCount)
                                            {
                                                if(rawReleaseNames[oppositeCheck] == parameterName && rawReleaseScopes[oppositeCheck] == functionScope && rawReleaseTokens[oppositeCheck] > functionBodyOpen && rawReleaseTokens[oppositeCheck] < functionBodyEnd && rawReleaseLoops[oppositeCheck] == 0 && rawReleaseBranches[oppositeCheck] == releaseBranch && rawReleaseArms[oppositeCheck] != rawReleaseArms[rawCheck])
                                                {
                                                    releasesParameter = true
                                                }
                                            }
                                        }
                                    }
                                }
                                if(releasesParameter)
                                {
                                    add(releaseFunctionNames, tokens[functionIndex])
                                    add(releaseFunctionParameters, parameterIndex)
                                }
                            }
                            parameterIndex = parameterIndex + 1
                            parameterStart = parameterScan + 1
                        }
                    }
                }
            }
        }
    }

    array<string> variables = array<string>{}
    array<int> allocationLines = array<int>{}
    array<int> allocationScopes = array<int>{}
    array<int> allocationLexicalScopes = array<int>{}
    array<string> allocationKinds = array<string>{}
    array<int> allocationTokens = array<int>{}
    array<bool> active = array<bool>{}
    array<int> releaseCandidates = array<int>{}
    array<int> releaseTokens = array<int>{}
    array<int> releaseBranches = array<int>{}
    array<int> releaseArms = array<int>{}
    array<string> freedNames = array<string>{}
    array<int> freedLines = array<int>{}
    array<int> freedScopes = array<int>{}
    array<int> freedTokens = array<int>{}
    array<bool> freedDoubleReported = array<bool>{}
    array<string> pointerAssignmentNames = array<string>{}
    array<int> pointerAssignmentScopes = array<int>{}
    array<int> pointerAssignmentTokens = array<int>{}
    array<int> pointerAssignmentBranches = array<int>{}
    array<int> pointerAssignmentArms = array<int>{}
    array<string> releasedAllocationNames = array<string>{}
    array<int> releasedAllocationScopes = array<int>{}
    array<int> releasedAllocationTokens = array<int>{}
    array<int> releasedAllocationIndexes = array<int>{}
    array<string> releasedThroughNames = array<string>{}
    array<string> aliasNames = array<string>{}
    array<int> aliasCandidates = array<int>{}
    array<int> aliasScopes = array<int>{}
    array<int> aliasLexicalScopes = array<int>{}
    array<int> aliasBranches = array<int>{}
    array<int> aliasArms = array<int>{}
    array<bool> aliasActive = array<bool>{}
    int candidateCount = 0
    Length(releaseFunctionNames)
    int releaseFunctionCount = Length

    for(index, 0, tokenCount)
    {
        bool allocationAssignment = false
        bool allocationIsDeclaration = false
        if((tokens[index] == "realloc" || tokens[index] == "reallocarray") && index + 3 < tokenCount && tokens[index + 1] == "(" && (index == 0 || tokens[index - 1] == ";" || tokens[index - 1] == "{" || tokens[index - 1] == "}"))
        {
            string reallocInputPointer = tokens[index + 2]
            bool reallocStackArrayArgument = false
            bool reallocStackScalarArgument = false
            bool reallocStringArgument = false
            bool reallocUninitializedArgument = false
            bool reallocAllocaArgument = false
            int reallocDeclarationScan = index - 1
            while(reallocDeclarationScan >= 2)
            {
                if(tokens[reallocDeclarationScan] == reallocInputPointer && tokenScopes[reallocDeclarationScan] == tokenScopes[index] && reallocDeclarationScan + 1 < index && tokens[reallocDeclarationScan + 1] == "[" && (tokens[reallocDeclarationScan - 1] == "char" || tokens[reallocDeclarationScan - 1] == "int" || tokens[reallocDeclarationScan - 1] == "const"))
                {
                    reallocStackArrayArgument = true
                }
                if(tokens[reallocDeclarationScan] == reallocInputPointer && tokenScopes[reallocDeclarationScan] == tokenScopes[index] && reallocDeclarationScan + 1 < index && (tokens[reallocDeclarationScan + 1] == ";" || tokens[reallocDeclarationScan + 1] == "=") && (tokens[reallocDeclarationScan - 1] == "char" || tokens[reallocDeclarationScan - 1] == "int" || tokens[reallocDeclarationScan - 1] == "long" || tokens[reallocDeclarationScan - 1] == "short" || tokens[reallocDeclarationScan - 1] == "float" || tokens[reallocDeclarationScan - 1] == "double"))
                {
                    reallocStackScalarArgument = true
                }
                reallocDeclarationScan = reallocDeclarationScan - 1
            }
            IsStackArrayObject(reallocInputPointer, tokenScopes[index], index, tokens, tokenScopes)
            int reallocStackChainMatch = IsStackArrayObject
            if(reallocStackChainMatch == 1)
            {
                reallocStackArrayArgument = true
            }
            IsStringLiteralObject(reallocInputPointer, tokenScopes[index], index, tokens, tokenScopes)
            int reallocStringMatch = IsStringLiteralObject
            if(reallocStringMatch == 1)
            {
                reallocStringArgument = true
            }
            IsUninitializedPointerObject(reallocInputPointer, tokenScopes[index], index, tokens, tokenScopes)
            int reallocUninitializedMatch = IsUninitializedPointerObject
            if(reallocUninitializedMatch == 1)
            {
                reallocUninitializedArgument = true
            }
            IsAllocaObject(reallocInputPointer, tokenScopes[index], index, tokens, tokenScopes)
            int reallocAllocaMatch = IsAllocaObject
            if(reallocAllocaMatch == 1)
            {
                reallocAllocaArgument = true
            }
            if(!reallocStackArrayArgument && !reallocStackScalarArgument)
            {
                int reallocAliasScan = index - 1
                while(reallocAliasScan >= 2)
                {
                    if(tokens[reallocAliasScan] == reallocInputPointer && tokenScopes[reallocAliasScan] == tokenScopes[index] && reallocAliasScan + 2 < index && tokens[reallocAliasScan + 1] == "=")
                    {
                        string reallocStackSource = tokens[reallocAliasScan + 2]
                        int reallocSourceScan = reallocAliasScan - 1
                        while(reallocSourceScan >= 2)
                        {
                            if(tokens[reallocSourceScan] == reallocStackSource && tokenScopes[reallocSourceScan] == tokenScopes[index] && reallocSourceScan + 1 < reallocAliasScan && tokens[reallocSourceScan + 1] == "[" && (tokens[reallocSourceScan - 1] == "char" || tokens[reallocSourceScan - 1] == "int" || tokens[reallocSourceScan - 1] == "const"))
                            {
                                reallocStackArrayArgument = true
                            }
                            reallocSourceScan = reallocSourceScan - 1
                        }
                    }
                    reallocAliasScan = reallocAliasScan - 1
                }
            }
            if(reallocStackArrayArgument)
            {
                ToString(tokenLines[index])
                string reallocStackLine = ToString
                Print("MEMORY|INVALID_REALLOC|" + path + "|" + reallocStackLine + "|" + reallocInputPointer + "|realloc called on a stack array")
            }
            else if(reallocStackScalarArgument)
            {
                ToString(tokenLines[index])
                string reallocScalarLine = ToString
