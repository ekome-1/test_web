int IsAllocator(string name)
{
    if(name == "malloc" || name == "calloc" || name == "realloc" || name == "strdup" || name == "strndup" || name == "aligned_alloc" || name == "reallocarray")
    {
        return 1
    }
    return 0
}

int IsReallocator(string name)
{
    if(name == "realloc" || name == "reallocarray")
    {
        return 1
    }
    return 0
}

int IsNonZeroIntegerLiteral(string value)
{
    if(value == "1" || value == "2" || value == "3" || value == "4" || value == "5" || value == "6" || value == "7" || value == "8" || value == "9" || value == "10" || value == "16" || value == "32" || value == "64" || value == "0x1" || value == "0x10" || value == "0X10")
    {
        return 1
    }
    return 0
}

int IsStackArrayObject(string name, int scope, int before, array<string> tokens, array<int> tokenScopes)
{
    string currentName = name
    int currentBefore = before
    for(chainDepth, 0, 8)
    {
        bool foundBinding = false
        int scan = currentBefore - 1
        while(scan >= 2)
        {
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 1 < currentBefore && tokens[scan + 1] == "[" && (tokens[scan - 1] == "char" || tokens[scan - 1] == "int" || tokens[scan - 1] == "const"))
            {
                return 1
            }
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 2 < currentBefore && tokens[scan + 1] == "=" && tokens[scan + 2] != "[")
            {
                currentName = tokens[scan + 2]
                currentBefore = scan
                foundBinding = true
                break
            }
            scan = scan - 1
        }
        if(!foundBinding)
        {
            return 0
        }
    }
    return 0
}

