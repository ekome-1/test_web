            {
                if(tokens[functionScan] == "(")
                {
                    functionParenDepth = functionParenDepth + 1
                }
                else if(tokens[functionScan] == ")")
                {
                    functionParenDepth = functionParenDepth - 1
                    if(functionParenDepth == 0)
                    {
                        functionCloseParen = functionScan
                        functionParamsEnded = true
                    }
                }
                functionScan = functionScan + 1
            }
            if(functionParamsEnded && functionCloseParen + 1 < tokenCount && tokens[functionCloseParen + 1] == "{")
            {
                string releasedParameterName = ""
                int parameterStart = functionIndex + 2
                int parameterDepth = 0
                int parameterIndex = 0
                int parameterScan = parameterStart
                while(parameterScan <= functionCloseParen)
                {
                    if(tokens[parameterScan] == "(" || tokens[parameterScan] == "[")
                    {
                        parameterDepth = parameterDepth + 1
                    }
                    else if(tokens[parameterScan] == ")" || tokens[parameterScan] == "]")
                    {
                        if(parameterDepth > 0)
                        {
                            parameterDepth = parameterDepth - 1
                        }
                    }
                    if((tokens[parameterScan] == "," && parameterDepth == 0) || parameterScan == functionCloseParen)
                    {
                        CParameterName(tokens, parameterStart, parameterScan)
                        string parameterName = CParameterName
                        if(parameterIndex == requestedParameter)
                        {
                            releasedParameterName = parameterName
                        }
                        parameterIndex = parameterIndex + 1
                        parameterStart = parameterScan + 1
                    }
                    parameterScan = parameterScan + 1
                }
                if(releasedParameterName != "")
                {
                    CStatementEnd(tokens, functionCloseParen + 1, tokenCount)
                    int functionBodyEnd = CStatementEnd
                    int functionScope = tokenScopes[functionCloseParen + 1]
                    array<string> releaseAliasNames = array<string>{}
                    array<int> releaseAliasScopes = array<int>{}
                    array<bool> releaseAliasActive = array<bool>{}
                    array<int> releaseAliasFreeTokens = array<int>{}
                    array<int> releaseAliasFreeBranches = array<int>{}
                    array<int> releaseAliasFreeArms = array<int>{}
                    int bodyScan = functionCloseParen + 2
                    while(bodyScan < functionBodyEnd)
                    {
                        if(tokens[bodyScan] == "=" && bodyScan > 0 && bodyScan + 1 < functionBodyEnd)
                        {
                            string targetName = tokens[bodyScan - 1]
                            bool targetIsMember = false
                            if(bodyScan >= 3 && tokens[bodyScan - 2] == ".")
                            {
                                targetName = tokens[bodyScan - 3]
                                targetIsMember = true
                            }
                            else if(bodyScan >= 4 && tokens[bodyScan - 2] == ">" && tokens[bodyScan - 3] == "-")
                            {
                                targetName = tokens[bodyScan - 4]
                                targetIsMember = true
                            }
                            bool sourceCarriesReleasedPointer = tokens[bodyScan + 1] == releasedParameterName
                            Length(releaseAliasNames)
                            int releaseAliasCount = Length
                            for(releaseAliasIndex, 0, releaseAliasCount)
                            {
                                if(releaseAliasActive[releaseAliasIndex] && tokens[bodyScan + 1] == releaseAliasNames[releaseAliasIndex] && releaseAliasScopes[releaseAliasIndex] <= tokenScopes[bodyScan])
                                {
                                    sourceCarriesReleasedPointer = true
                                }
                            }
                            if(sourceCarriesReleasedPointer && !targetIsMember && targetName != "*" && targetName != "&" && tokenScopes[bodyScan - 1] >= functionScope)
                            {
                                bool knownReleaseAlias = false
                                for(releaseAliasCheck, 0, releaseAliasCount)
                                {
                                    if(releaseAliasNames[releaseAliasCheck] == targetName && releaseAliasScopes[releaseAliasCheck] == tokenScopes[bodyScan - 1])
                                    {
                                        releaseAliasActive[releaseAliasCheck] = true
                                        knownReleaseAlias = true
                                    }
                                }
                                if(!knownReleaseAlias)
                                {
                                    add(releaseAliasNames, targetName)
                                    add(releaseAliasScopes, tokenScopes[bodyScan - 1])
                                    add(releaseAliasActive, true)
                                }
                            }
                            else if(!targetIsMember && targetName != "*" && targetName != "&")
                            {
                                for(releaseAliasClear, 0, releaseAliasCount)
                                {
                                    if(releaseAliasNames[releaseAliasClear] == targetName && releaseAliasScopes[releaseAliasClear] == tokenScopes[bodyScan - 1])
                                    {
                                        releaseAliasActive[releaseAliasClear] = false
                                    }
                                }
                            }
                        }
                        if(tokens[bodyScan] == "free" && bodyScan + 3 < functionBodyEnd && tokens[bodyScan + 1] == "(" && tokens[bodyScan + 3] == ")")
                        {
                            string releasedName = tokens[bodyScan + 2]
                            Length(releaseAliasNames)
                            int releaseAliasCountForFree = Length
                            bool releaseAliasMatched = false
                            for(releaseAliasFreeIndex, 0, releaseAliasCountForFree)
                            {
                                if(releaseAliasActive[releaseAliasFreeIndex] && releaseAliasNames[releaseAliasFreeIndex] == releasedName && releaseAliasScopes[releaseAliasFreeIndex] <= tokenScopes[bodyScan])
                                {
                                    releaseAliasMatched = true
                                }
                            }
                            if(releaseAliasMatched)
                            {
                                add(releaseAliasFreeTokens, bodyScan)
                                add(releaseAliasFreeBranches, tokenBranchIDs[bodyScan])
                                add(releaseAliasFreeArms, tokenBranchArms[bodyScan])
                            }
                        }
                        bodyScan = bodyScan + 1
                    }
                    Length(releaseAliasFreeTokens)
                    int releaseAliasFreeCount = Length
                    Length(branchHasElse)
                    int branchCount = Length
                    for(releaseAliasFirstFree, 0, releaseAliasFreeCount)
                    {
                        int firstFreeBranch = releaseAliasFreeBranches[releaseAliasFirstFree]
                        if(firstFreeBranch == 0)
                        {
                            return 1
                        }
                        if(firstFreeBranch > 0 && firstFreeBranch <= branchCount && branchParents[firstFreeBranch - 1] == 0 && branchHasElse[firstFreeBranch - 1])
                        {
                            for(releaseAliasSecondFree, 0, releaseAliasFreeCount)
                            {
                                if(releaseAliasFreeBranches[releaseAliasSecondFree] == firstFreeBranch && releaseAliasFreeArms[releaseAliasSecondFree] != releaseAliasFreeArms[releaseAliasFirstFree])
                                {
                                    return 1
                                }
                            }
                        }
                    }
                }
            }
        }
        functionIndex = functionIndex + 1
    }
    return 0
}

int FindStackEscapeThroughOutputParameter(string functionName, int requestedParameter, int tokenCount, array<string> tokens, array<int> tokenScopes)
{
    int functionIndex = 0
