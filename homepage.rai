                    bool returnMatches = variables[candidateIndex] == returnedPointer && returnCandidateDistance == nearestReturnDistance
                    Length(aliasNames)
                    int returnAliasCount = Length
                    for(returnAliasIndex, 0, returnAliasCount)
                    {
                        IsResolvedAliasForCandidate(returnedPointer, candidateIndex, tokenScopes[index], tokenLexicalScopes[index], tokenBranchIDs[index], tokenBranchArms[index], aliasNames, aliasCandidates, aliasScopes, aliasLexicalScopes, aliasBranches, aliasArms, aliasActive, lexicalScopeParents, branchParents, branchParentArms)
                        int returnAliasResolves = IsResolvedAliasForCandidate
                        if(aliasActive[returnAliasIndex] && aliasNames[returnAliasIndex] == returnedPointer && aliasCandidates[returnAliasIndex] == candidateIndex && aliasScopes[returnAliasIndex] == tokenScopes[index] && returnAliasResolves == 1)
                        {
                            IsBranchContextWithin(tokenBranchIDs[index], tokenBranchArms[index], aliasBranches[returnAliasIndex], aliasArms[returnAliasIndex], branchParents, branchParentArms)
                            int returnAliasContext = IsBranchContextWithin
                            if(returnAliasContext == 1)
                            {
                                returnMatches = true
                            }
                        }
                    }
                    if(returnMatches)
                    {
                        add(releaseCandidates, candidateIndex)
                        add(releaseTokens, index)
                        add(releaseBranches, tokenBranchIDs[index])
                        add(releaseArms, tokenBranchArms[index])
                        if(tokenBranchIDs[index] == 0 && tokenLoopIDs[index] == 0)
                        {
                            active[candidateIndex] = false
                        }
                    }
                }
            }
        }
    }
    for(candidateIndex, 0, candidateCount)
    {
        if(active[candidateIndex])
        {
            IsCandidateReleased(candidateIndex, tokenCount, allocationTokens, releaseCandidates, releaseTokens, releaseBranches, releaseArms, tokenLoopIDs, tokenBranchIDs, tokenBranchArms, branchIfTokens, branchElseEnds, branchHasElse, branchParents, branchParentArms)
            int releasedAtEnd = IsCandidateReleased
            if(releasedAtEnd == 1)
            {
                active[candidateIndex] = false
            }
        }
        if(!active[candidateIndex])
        {
            HasPartialSwitchRelease(candidateIndex, allocationTokens[candidateIndex], allocationScopes[candidateIndex], tokenCount, tokens, tokenScopes, releasedAllocationIndexes, releasedAllocationTokens)
            int partialSwitchRelease = HasPartialSwitchRelease
            if(partialSwitchRelease == 1)
            {
                ToString(allocationLines[candidateIndex])
                string partialSwitchLineText = ToString
                string partialSwitchFinding = "LEAK|" + path + "|" + partialSwitchLineText + "|" + variables[candidateIndex] + "|" + allocationKinds[candidateIndex] + "|allocation is not released on every switch path"
                Print(partialSwitchFinding)
            }
            HasPartialGotoRelease(candidateIndex, variables, allocationTokens[candidateIndex], allocationScopes[candidateIndex], tokenCount, tokens, tokenScopes, tokenBranchIDs, releasedAllocationIndexes, releasedAllocationTokens, releaseCandidates, releaseTokens)
            int partialGotoRelease = HasPartialGotoRelease
            if(partialGotoRelease == 1)
            {
                ToString(allocationLines[candidateIndex])
                string partialGotoLineText = ToString
                string partialGotoFinding = "LEAK|" + path + "|" + partialGotoLineText + "|" + variables[candidateIndex] + "|" + allocationKinds[candidateIndex] + "|allocation is not released on every goto path"
                Print(partialGotoFinding)
            }
        }
        if(active[candidateIndex])
        {
            ToString(allocationLines[candidateIndex])
            string lineText = ToString
            string finding = "LEAK|" + path + "|" + lineText + "|" + variables[candidateIndex] + "|" + allocationKinds[candidateIndex] + "|no matching free() found in this function"
            Print(finding)
        }
    }

    ToString(candidateCount)
    string countText = ToString
    Print("SCAN|" + path + "|" + countText)
    return collectedReleaseSummaries
}
