import std_web

capsule RaichoCLeakScout

struct ReleaseSummary
{
    string name
    int parameter
    int kind
    string member
}
int Main()
{
    Input()
    ToInt(Input)
    int fileCount = ToInt
    array<string> paths = array<string>{}
    array<int> lineCounts = array<int>{}
    array<int> lineStarts = array<int>{}
    array<string> sourceLines = array<string>{}
    for(fileIndex, 0, fileCount)
    {
        Input()
        string path = Input
        Input()
        ToInt(Input)
        int lineCount = ToInt
        Length(sourceLines)
        int sourceStart = Length
        add(paths, path)
        add(lineCounts, lineCount)
        add(lineStarts, sourceStart)
        for(lineIndex, 0, lineCount)
        {
            Input()
            add(sourceLines, Input)
        }
    }
    array<ReleaseSummary> externalReleaseSummaries = array<ReleaseSummary>{}
    for(summaryRound, 0, 8)
    {
        Length(externalReleaseSummaries)
        int summaryCountBeforeRound = Length
        for(collectIndex, 0, fileCount)
        {
            AnalyzeFile(paths[collectIndex], lineCounts[collectIndex], lineStarts[collectIndex], sourceLines, true, externalReleaseSummaries)
            array<ReleaseSummary> fileReleaseSummaries = AnalyzeFile
            Length(fileReleaseSummaries)
            int fileReleaseCount = Length
            for(fileReleaseIndex, 0, fileReleaseCount)
            {
                bool alreadyRegistered = false
                Length(externalReleaseSummaries)
                int externalReleaseCount = Length
                for(externalCheck, 0, externalReleaseCount)
                {
                    if(externalReleaseSummaries[externalCheck].name == fileReleaseSummaries[fileReleaseIndex].name && externalReleaseSummaries[externalCheck].parameter == fileReleaseSummaries[fileReleaseIndex].parameter && externalReleaseSummaries[externalCheck].kind == fileReleaseSummaries[fileReleaseIndex].kind && externalReleaseSummaries[externalCheck].member == fileReleaseSummaries[fileReleaseIndex].member)
                    {
                        alreadyRegistered = true
                    }
                }
                if(!alreadyRegistered)
                {
                    add(externalReleaseSummaries, fileReleaseSummaries[fileReleaseIndex])
                }
            }
        }
        Length(externalReleaseSummaries)
        int summaryCountAfterRound = Length
        if(summaryCountAfterRound == summaryCountBeforeRound)
        {
            break
        }
    }
    for(analyzeIndex, 0, fileCount)
    {
        AnalyzeFile(paths[analyzeIndex], lineCounts[analyzeIndex], lineStarts[analyzeIndex], sourceLines, false, externalReleaseSummaries)
    }
    return 0
}

int IsAllocator(string name)
{
    if(name == "malloc" || name == "calloc" || name == "realloc" || name == "reallocf" || name == "strdup" || name == "strndup" || name == "memdup" || name == "memdup2" || name == "aligned_alloc" || name == "reallocarray" || name == "recallocarray" || name == "memalign" || name == "valloc" || name == "pvalloc")
    {
        return 1
    }
    return 0
}

int IsBuiltinOutputAllocator(string name)
{
    if(name == "getline" || name == "getdelim" || name == "asprintf" || name == "vasprintf")
    {
        return 1
    }
    return 0
}

int IsBuiltinOutputWriteBefore(string name, int scope, int before, array<string> tokens, array<int> tokenScopes)
{
    int scan = before - 1
    while(scan >= 1)
    {
        if(tokens[scan] == name && tokenScopes[scan] == scope && tokens[scan - 1] == "&")
        {
            int openScan = scan - 1
            int parentheses = 0
            while(openScan >= 0)
            {
                if(tokens[openScan] == ")")
                {
                    parentheses = parentheses + 1
                }
                else if(tokens[openScan] == "(")
                {
                    if(parentheses > 0)
                    {
                        parentheses = parentheses - 1
                    }
                    else if(openScan > 0)
                    {
                        IsBuiltinOutputAllocator(tokens[openScan - 1])
                        int builtinOutputWrite = IsBuiltinOutputAllocator
                        if(builtinOutputWrite == 1)
                        {
                            GetCallArgumentIndex(openScan - 1, scan, tokens)
                            int outputArgumentIndex = GetCallArgumentIndex
                            if(outputArgumentIndex == 0)
                            {
                                return 1
                            }
                        }
                        break
                    }
                }
                openScan = openScan - 1
            }
        }
        scan = scan - 1
    }
    return 0
}

string GetSimpleMemberExpression(int memberIndex, array<string> tokens)
{
    if(memberIndex < 0)
    {
        return ""
    }
    string expression = tokens[memberIndex]
    int scan = memberIndex - 1
    bool foundMemberOperator = false
    while(scan >= 0)
    {
        if(tokens[scan] == "." && scan > 0)
        {
            expression = tokens[scan - 1] + "." + expression
            scan = scan - 2
            foundMemberOperator = true
        }
        else if(tokens[scan] == ">" && scan > 1 && tokens[scan - 1] == "-")
        {
            expression = tokens[scan - 2] + "->" + expression
            scan = scan - 3
            foundMemberOperator = true
        }
        else
        {
            break
        }
    }
    if(foundMemberOperator)
    {
        return expression
    }
    return ""
}

int IsReallocator(string name)
{
    if(name == "realloc" || name == "reallocf" || name == "reallocarray" || name == "recallocarray")
    {
        return 1
    }
    return 0
}

int IsNonZeroIntegerLiteral(string value)
{
    if(value == "1" || value == "2" || value == "3" || value == "4" || value == "5" || value == "6" || value == "7" || value == "8" || value == "9" || value == "10" || value == "16" || value == "32" || value == "64" || value == "128" || value == "256" || value == "512" || value == "1024" || value == "2048" || value == "4096" || value == "8192" || value == "16384" || value == "32768" || value == "65536" || value == "131072" || value == "262144" || value == "524288" || value == "1048576" || value == "2097152" || value == "4194304" || value == "8388608" || value == "16777216" || value == "33554432" || value == "67108864" || value == "134217728" || value == "268435456" || value == "536870912" || value == "1073741824" || value == "0x1" || value == "0x10")
    {
        return 1
    }
    return 0
}

int IsKnownNonNegativeIntegerLiteral(string value)
{
    if(value == "0")
    {
        return 1
    }
    IsNonZeroIntegerLiteral(value)
    int nonZero = IsNonZeroIntegerLiteral
    return nonZero
}

int GetKnownArrayBound(string name, int scope, int before, array<string> tokens, array<int> tokenScopes)
{
    string currentName = name
    int currentBefore = before
    for(chainDepth, 0, 8)
    {
        bool foundBinding = false
        int scan = currentBefore - 1
        while(scan >= 2)
        {
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 3 < currentBefore && tokens[scan + 1] == "[" && tokens[scan + 3] == "]" && (tokens[scan - 1] == "char" || tokens[scan - 1] == "int" || tokens[scan - 1] == "const" || tokens[scan - 1] == "long"))
            {
                IsKnownNonNegativeIntegerLiteral(tokens[scan + 2])
                int knownBound = IsKnownNonNegativeIntegerLiteral
                if(knownBound == 1)
                {
                    ToInt(tokens[scan + 2])
                    int arrayBound = ToInt
                    return arrayBound
                }
                return -1
            }
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 2 < currentBefore && tokens[scan + 1] == "=" && tokens[scan + 2] != "[")
            {
                currentName = tokens[scan + 2]
                currentBefore = scan
                foundBinding = true
                break
            }
            scan = scan - 1
        }
        if(!foundBinding)
        {
            return -1
        }
    }
    return -1
}

int GetEscapedStackArrayLexicalScope(string name, int before, array<string> tokens, array<int> tokenLexicalScopes)
{
    string currentName = name
    int currentBefore = before
    for(chainDepth, 0, 8)
    {
        bool foundBinding = false
        int scan = currentBefore - 1
        while(scan >= 2)
        {
            if(tokens[scan] == currentName && scan + 1 < currentBefore && tokens[scan + 1] == "[" && (tokens[scan - 1] == "char" || tokens[scan - 1] == "int" || tokens[scan - 1] == "const" || tokens[scan - 1] == "long"))
            {
                return tokenLexicalScopes[scan]
            }
            if(tokens[scan] == currentName && scan + 2 < currentBefore && tokens[scan + 1] == "=" && tokens[scan + 2] != "[")
            {
                currentName = tokens[scan + 2]
                currentBefore = scan
                foundBinding = true
                break
            }
            scan = scan - 1
        }
        if(!foundBinding)
        {
            return -1
        }
    }
    return -1
}

int GetBufferOperationSize(int functionIndex, int tokenCount, array<string> tokens)
{
    int scan = functionIndex + 2
    int parentheses = 0
    int argumentIndex = 0
    int sizeStart = -1
    bool callEnded = false
    while(scan < tokenCount && !callEnded)
    {
        if(tokens[scan] == "(")
        {
            parentheses = parentheses + 1
        }
        else if(tokens[scan] == ")")
        {
            if(parentheses == 0)
            {
                callEnded = true
            }
            else
            {
                parentheses = parentheses - 1
            }
        }
        else if(tokens[scan] == "," && parentheses == 0)
        {
            argumentIndex = argumentIndex + 1
            if(argumentIndex == 2)
            {
                sizeStart = scan + 1
            }
        }
        scan = scan + 1
    }
    if(sizeStart >= 0 && sizeStart + 1 < tokenCount && tokens[sizeStart + 1] == ")")
    {
        IsKnownNonNegativeIntegerLiteral(tokens[sizeStart])
        int sizeKnown = IsKnownNonNegativeIntegerLiteral
        if(sizeKnown == 1)
        {
            ToInt(tokens[sizeStart])
            int operationSize = ToInt
            return operationSize
        }
    }
    return -1
}

int GetCallConstantArgument(int functionIndex, int requestedArgument, int tokenCount, array<string> tokens)
{
    int scan = functionIndex + 2
    int parentheses = 0
    int argumentIndex = 0
    int valueStart = scan
    bool callEnded = false
    while(scan < tokenCount && !callEnded)
    {
        bool argumentEnded = false
        if(tokens[scan] == "(")
        {
            parentheses = parentheses + 1
        }
        else if(tokens[scan] == ")")
        {
            if(parentheses == 0)
            {
                argumentEnded = true
                callEnded = true
            }
            else
            {
                parentheses = parentheses - 1
            }
        }
        else if(tokens[scan] == "," && parentheses == 0)
        {
            argumentEnded = true
        }
        if(argumentEnded)
        {
            if(argumentIndex == requestedArgument && valueStart + 1 == scan)
            {
                IsKnownNonNegativeIntegerLiteral(tokens[valueStart])
                int valueKnown = IsKnownNonNegativeIntegerLiteral
                if(valueKnown == 1)
                {
                    ToInt(tokens[valueStart])
                    int argumentValue = ToInt
                    return argumentValue
                }
            }
            if(!callEnded)
            {
                argumentIndex = argumentIndex + 1
                valueStart = scan + 1
            }
        }
        scan = scan + 1
    }
    return -1
}

int GetCallKnownSizeArgument(int functionIndex, int requestedArgument, int tokenCount, array<string> tokens)
{
    int scan = functionIndex + 2
    int parentheses = 0
    int argumentIndex = 0
    int valueStart = scan
    bool callEnded = false
    while(scan < tokenCount && !callEnded)
    {
        bool argumentEnded = false
        if(tokens[scan] == "(")
        {
            parentheses = parentheses + 1
        }
        else if(tokens[scan] == ")")
        {
            if(parentheses == 0)
            {
                argumentEnded = true
                callEnded = true
            }
            else
            {
                parentheses = parentheses - 1
            }
        }
        else if(tokens[scan] == "," && parentheses == 0)
        {
            argumentEnded = true
        }
        if(argumentEnded)
        {
            if(argumentIndex == requestedArgument)
            {
                if(valueStart + 1 == scan)
                {
                    IsKnownNonNegativeIntegerLiteral(tokens[valueStart])
                    int directKnown = IsKnownNonNegativeIntegerLiteral
                    if(directKnown == 1)
                    {
                        ToInt(tokens[valueStart])
                        int directValue = ToInt
                        return directValue
                    }
                }
                else if(valueStart + 3 == scan && tokens[valueStart + 1] == "*")
                {
                    IsKnownNonNegativeIntegerLiteral(tokens[valueStart])
                    int firstKnown = IsKnownNonNegativeIntegerLiteral
                    IsKnownNonNegativeIntegerLiteral(tokens[valueStart + 2])
                    int secondKnown = IsKnownNonNegativeIntegerLiteral
                    if(firstKnown == 1 && secondKnown == 1)
                    {
                        ToInt(tokens[valueStart])
                        int firstValue = ToInt
                        ToInt(tokens[valueStart + 2])
                        int secondValue = ToInt
                        GetKnownConstantProduct(firstValue, secondValue)
                        int product = GetKnownConstantProduct
                        if(product < 0)
                        {
                            return -2
                        }
                        return product
                    }
                }
            }
            if(!callEnded)
            {
                argumentIndex = argumentIndex + 1
                valueStart = scan + 1
            }
        }
        scan = scan + 1
    }
    return -1
}

string GetPosixMemalignOutputName(int functionIndex, int tokenCount, array<string> tokens)
{
    if(functionIndex + 4 < tokenCount && tokens[functionIndex + 1] == "(" && tokens[functionIndex + 2] == "&" && tokens[functionIndex + 4] == ",")
    {
        return tokens[functionIndex + 3]
    }
    if(functionIndex + 9 < tokenCount && tokens[functionIndex + 1] == "(" && tokens[functionIndex + 2] == "(" && tokens[functionIndex + 3] == "void" && tokens[functionIndex + 4] == "*" && tokens[functionIndex + 5] == "*" && tokens[functionIndex + 6] == ")" && tokens[functionIndex + 7] == "&" && tokens[functionIndex + 9] == ",")
    {
        return tokens[functionIndex + 8]
    }
    return ""
}

string GetCallSimpleArgument(int functionIndex, int requestedArgument, int tokenCount, array<string> tokens)
{
    int scan = functionIndex + 2
    int parentheses = 0
    int argumentIndex = 0
    int valueStart = scan
    bool callEnded = false
    while(scan < tokenCount && !callEnded)
    {
        bool argumentEnded = false
        if(tokens[scan] == "(")
        {
            parentheses = parentheses + 1
        }
        else if(tokens[scan] == ")")
        {
            if(parentheses == 0)
            {
                argumentEnded = true
                callEnded = true
            }
            else
            {
                parentheses = parentheses - 1
            }
        }
        else if(tokens[scan] == "," && parentheses == 0)
        {
            argumentEnded = true
        }
        if(argumentEnded)
        {
            if(argumentIndex == requestedArgument && valueStart + 1 == scan)
            {
                return tokens[valueStart]
            }
            if(!callEnded)
            {
                argumentIndex = argumentIndex + 1
                valueStart = scan + 1
            }
        }
        scan = scan + 1
    }
    return ""
}

int GetKnownConstantProduct(int firstValue, int secondValue)
{
    if(firstValue < 0 || secondValue < 0)
    {
        return -1
    }
    if(firstValue == 0 || secondValue == 0)
    {
        return 0
    }
    if(firstValue > 2147483647 / secondValue)
    {
        return -1
    }
    return firstValue * secondValue
}

int GetKnownAllocationSize(string allocatorName, int functionIndex, int tokenCount, array<string> tokens)
{
    if(allocatorName == "malloc" || allocatorName == "realloc" || allocatorName == "reallocf" || allocatorName == "aligned_alloc" || allocatorName == "memalign" || allocatorName == "valloc" || allocatorName == "memdup" || allocatorName == "memdup2")
    {
        int sizeArgumentIndex = 0
        if(allocatorName == "realloc" || allocatorName == "reallocf" || allocatorName == "aligned_alloc" || allocatorName == "memalign" || allocatorName == "memdup" || allocatorName == "memdup2")
        {
            sizeArgumentIndex = 1
        }
        GetCallKnownSizeArgument(functionIndex, sizeArgumentIndex, tokenCount, tokens)
        int knownSize = GetCallKnownSizeArgument
        return knownSize
    }
    if(allocatorName == "calloc" || allocatorName == "reallocarray" || allocatorName == "recallocarray")
    {
        int firstArgumentIndex = 0
        int secondArgumentIndex = 1
        if(allocatorName == "reallocarray")
        {
            firstArgumentIndex = 1
            secondArgumentIndex = 2
        }
        else if(allocatorName == "recallocarray")
        {
            firstArgumentIndex = 2
            secondArgumentIndex = 3
        }
        GetCallConstantArgument(functionIndex, firstArgumentIndex, tokenCount, tokens)
        int firstSize = GetCallConstantArgument
        GetCallConstantArgument(functionIndex, secondArgumentIndex, tokenCount, tokens)
        int secondSize = GetCallConstantArgument
        GetKnownConstantProduct(firstSize, secondSize)
        int productSize = GetKnownConstantProduct
        return productSize
    }
    if(allocatorName == "strndup")
    {
        GetCallConstantArgument(functionIndex, 1, tokenCount, tokens)
        int stringLimit = GetCallConstantArgument
        if(stringLimit >= 0 && stringLimit < 2147483647)
        {
            return stringLimit + 1
        }
    }
    return -1
}

int IsAllocationSizeProductOverflow(string functionName, int functionIndex, int tokenCount, array<string> tokens)
{
    if(functionName == "malloc" || functionName == "realloc" || functionName == "reallocf" || functionName == "aligned_alloc")
    {
        int sizeArgumentIndex = 0
        if(functionName == "realloc" || functionName == "reallocf" || functionName == "aligned_alloc")
        {
            sizeArgumentIndex = 1
        }
        GetCallKnownSizeArgument(functionIndex, sizeArgumentIndex, tokenCount, tokens)
        int knownSizeExpression = GetCallKnownSizeArgument
        if(knownSizeExpression == -2)
        {
            return 1
        }
        return 0
    }
    if(functionName != "calloc" && functionName != "reallocarray" && functionName != "recallocarray")
    {
        return 0
    }
    int firstArgumentIndex = 0
    int secondArgumentIndex = 1
    if(functionName == "reallocarray")
    {
        firstArgumentIndex = 1
        secondArgumentIndex = 2
    }
    else if(functionName == "recallocarray")
    {
        firstArgumentIndex = 2
        secondArgumentIndex = 3
    }
    GetCallConstantArgument(functionIndex, firstArgumentIndex, tokenCount, tokens)
    int firstSize = GetCallConstantArgument
    GetCallConstantArgument(functionIndex, secondArgumentIndex, tokenCount, tokens)
    int secondSize = GetCallConstantArgument
    if(firstSize < 0 || secondSize < 0 || firstSize == 0 || secondSize == 0)
    {
        return 0
    }
    if((firstSize >= 65536 && secondSize >= 65536) || (firstSize >= 1073741824 && secondSize >= 4) || (firstSize >= 536870912 && secondSize >= 8) || (firstSize >= 268435456 && secondSize >= 16) || (firstSize >= 131072 && secondSize >= 32768))
    {
        return 1
    }
    return 0
}

int FindCallFunctionIndex(int targetIndex, string functionName, array<string> tokens)
{
    int scan = targetIndex - 1
    int parentheses = 0
    while(scan >= 1)
    {
        if(tokens[scan] == ")")
        {
            parentheses = parentheses + 1
        }
        else if(tokens[scan] == "(")
        {
            if(parentheses > 0)
            {
                parentheses = parentheses - 1
            }
            else if(tokens[scan - 1] == functionName)
            {
                return scan - 1
            }
        }
        scan = scan - 1
    }
    return -1
}

int GetCallArgumentIndex(int functionIndex, int targetIndex, array<string> tokens)
{
    int scan = functionIndex + 2
    int parentheses = 0
    int argumentIndex = 0
    while(scan < targetIndex)
    {
        if(tokens[scan] == "(")
        {
            parentheses = parentheses + 1
        }
        else if(tokens[scan] == ")")
        {
            if(parentheses > 0)
            {
                parentheses = parentheses - 1
            }
        }
        else if(tokens[scan] == "," && parentheses == 0)
        {
            argumentIndex = argumentIndex + 1
        }
        scan = scan + 1
    }
    return argumentIndex
}

int IsDerivedPointerExpression(int start, int end, array<string> tokens)
{
    int scan = start
    while(scan < end)
    {
        if(tokens[scan] == "-" && scan + 1 < end && tokens[scan + 1] == ">")
        {
            scan = scan + 1
        }
        else if(tokens[scan] == "+" || tokens[scan] == "-")
        {
            if(scan + 1 >= end)
            {
                return 1
            }
            if(tokens[scan + 1] != "0")
            {
                return 1
            }
        }
        if(tokens[scan] == "[")
        {
            if(scan + 1 >= end)
            {
                return 1
            }
            if(tokens[scan + 1] != "0")
            {
                return 1
            }
            if(scan + 2 >= end)
            {
                return 1
            }
            if(tokens[scan + 2] != "]")
            {
                return 1
            }
        }
        if(tokens[scan] == "&")
        {
            if(scan + 4 >= end)
            {
                return 1
            }
            if(tokens[scan + 2] != "[" || tokens[scan + 3] != "0" || tokens[scan + 4] != "]")
            {
                return 1
            }
            scan = scan + 4
        }
        scan = scan + 1
    }
    return 0
}

int IsStackArrayObject(string name, int scope, int before, array<string> tokens, array<int> tokenScopes)
{
    string currentName = name
    int currentBefore = before
    for(chainDepth, 0, 8)
    {
        bool foundBinding = false
        int scan = currentBefore - 1
        while(scan >= 2)
        {
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 1 < currentBefore && tokens[scan + 1] == "[" && (tokens[scan - 1] == "char" || tokens[scan - 1] == "int" || tokens[scan - 1] == "const"))
            {
                return 1
            }
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 2 < currentBefore && tokens[scan + 1] == "=" && tokens[scan + 2] != "[")
            {
                currentName = tokens[scan + 2]
                currentBefore = scan
                foundBinding = true
                break
            }
            scan = scan - 1
        }
        if(!foundBinding)
        {
            return 0
        }
    }
    return 0
}

int IsDeclaredStructArrayMember(string baseName, string memberName, int scope, int before, int tokenCount, array<string> tokens, array<int> tokenScopes)
{
    string structName = ""
    int declarationScan = before - 1
    while(declarationScan >= 3 && structName == "")
    {
        if(tokens[declarationScan] == baseName && tokenScopes[declarationScan] == scope && declarationScan + 1 < before && (tokens[declarationScan + 1] == ";" || tokens[declarationScan + 1] == "="))
        {
            if(tokens[declarationScan - 2] == "struct")
            {
                structName = tokens[declarationScan - 1]
            }
            else if(declarationScan >= 3 && tokens[declarationScan - 3] == "struct" && tokens[declarationScan - 2] != "*")
            {
                structName = tokens[declarationScan - 2]
            }
        }
        declarationScan = declarationScan - 1
    }
    if(structName == "")
    {
        return 0
    }
    int structScan = 0
    while(structScan + 2 < tokenCount)
    {
        if(tokens[structScan] == "struct" && tokens[structScan + 1] == structName && tokens[structScan + 2] == "{")
        {
            int structDepth = 1
            int memberScan = structScan + 3
            while(memberScan < tokenCount && structDepth > 0)
            {
                if(tokens[memberScan] == "{")
                {
                    structDepth = structDepth + 1
                }
                else if(tokens[memberScan] == "}")
                {
                    structDepth = structDepth - 1
                }
                if(structDepth == 1 && tokens[memberScan] == memberName && memberScan + 1 < tokenCount && tokens[memberScan + 1] == "[")
                {
                    return 1
                }
                memberScan = memberScan + 1
            }
        }
        structScan = structScan + 1
    }
    return 0
}

