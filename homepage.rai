int IsUninitializedPointerObject(string name, int scope, int before, array<string> tokens, array<int> tokenScopes)
{
    string currentName = name
    int currentBefore = before
    for(chainDepth, 0, 8)
    {
        int outputScan = currentBefore - 1
        while(outputScan >= 0)
        {
            if(tokens[outputScan] == "posix_memalign" && tokenScopes[outputScan] == scope)
            {
                GetPosixMemalignOutputName(outputScan, currentBefore + 2, tokens)
                string outputNameBeforeDeclaration = GetPosixMemalignOutputName
                if(outputNameBeforeDeclaration == currentName)
                {
                    return 0
                }
            }
            outputScan = outputScan - 1
        }
        bool foundBinding = false
        int scan = currentBefore - 1
        while(scan >= 2)
        {
            if(tokens[scan] == "posix_memalign" && tokenScopes[scan] == scope)
            {
                GetPosixMemalignOutputName(scan, before, tokens)
                string outputName = GetPosixMemalignOutputName
                if(outputName == currentName)
                {
                    return 0
                }
            }
            bool pointerDeclaration = false
            if(tokens[scan - 1] == "*" && scan >= 2 && (tokens[scan - 2] == "char" || tokens[scan - 2] == "int" || tokens[scan - 2] == "void" || tokens[scan - 2] == "long" || tokens[scan - 2] == "short" || tokens[scan - 2] == "float" || tokens[scan - 2] == "double" || tokens[scan - 2] == "const" || tokens[scan - 2] == "volatile"))
            {
                pointerDeclaration = true
            }
            if(tokens[scan - 1] == "*" && scan >= 3 && tokens[scan - 3] == "struct")
            {
                pointerDeclaration = true
            }
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 1 < currentBefore && tokens[scan + 1] == ";" && pointerDeclaration)
            {
                return 1
            }
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 2 < currentBefore && tokens[scan + 1] == "=" && tokens[scan + 2] != "[")
            {
                currentName = tokens[scan + 2]
                currentBefore = scan
                foundBinding = true
                break
            }
            scan = scan - 1
        }
        if(!foundBinding)
        {
            return 0
        }
    }
    return 0
}

int IsNullPointerObject(string name, int scope, int before, array<string> tokens, array<int> tokenScopes)
