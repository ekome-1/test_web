int IsCandidateReleased(int candidateIndex, int tokenLimit, array<int> allocationTokens, array<int> releaseCandidates, array<int> releaseTokens, array<int> releaseBranches, array<int> releaseArms, array<int> tokenLoops, array<int> tokenBranches, array<int> tokenArms, array<int> branchIfTokens, array<int> branchElseEnds, array<bool> branchHasElse, array<int> branchParents, array<int> branchParentArms)
{
    int allocationToken = allocationTokens[candidateIndex]
    if(tokenLimit <= allocationToken)
    {
        return 0
    }

    Length(branchIfTokens)
    int branchCount = Length
    Length(releaseCandidates)
    int releaseCount = Length
    if(releaseCount == 0)
    {
        return 0
    }
    array<bool> thenCovered = array<bool>{}
    array<bool> elseCovered = array<bool>{}
    for(branchIndex, 0, branchCount)
    {
        add(thenCovered, false)
        add(elseCovered, false)
    }

    for(releaseIndex, 0, releaseCount)
    {
        if(releaseCandidates[releaseIndex] == candidateIndex && releaseTokens[releaseIndex] > allocationToken && releaseTokens[releaseIndex] < tokenLimit && tokenLoops[releaseTokens[releaseIndex]] == 0)
        {
            int releaseBranch = releaseBranches[releaseIndex]
            if(releaseBranch == 0)
            {
                return 1
            }
            if(releaseArms[releaseIndex] == 1)
            {
                thenCovered[releaseBranch - 1] = true
            }
            else if(releaseArms[releaseIndex] == 2)
            {
                elseCovered[releaseBranch - 1] = true
            }
        }
    }

    int reverseIndex = branchCount - 1
    while(reverseIndex >= 0)
    {
        int group = reverseIndex + 1
        int parent = branchParents[reverseIndex]

        bool allocationInside = false
        int allocationArm = 0
        int ancestor = tokenBranches[allocationToken]
        int ancestorArm = tokenArms[allocationToken]
        while(ancestor > 0)
        {
            if(ancestor == group)
            {
                allocationInside = true
                allocationArm = ancestorArm
                ancestor = 0
            }
            else
            {
                ancestorArm = branchParentArms[ancestor - 1]
                ancestor = branchParents[ancestor - 1]
            }
        }

        bool guaranteed = false
        if(allocationInside)
        {
            if(allocationArm == 1 && thenCovered[reverseIndex])
            {
                guaranteed = true
            }
            else if(allocationArm == 2 && elseCovered[reverseIndex])
            {
                guaranteed = true
            }
        }
        else if(allocationToken < branchIfTokens[reverseIndex] && branchHasElse[reverseIndex] && branchElseEnds[reverseIndex] > 0 && branchElseEnds[reverseIndex] <= tokenLimit && thenCovered[reverseIndex] && elseCovered[reverseIndex])
        {
            guaranteed = true
        }

        if(guaranteed)
        {
            if(parent > 0)
            {
                if(branchParentArms[reverseIndex] == 1)
                {
                    thenCovered[parent - 1] = true
                }
                else if(branchParentArms[reverseIndex] == 2)
                {
                    elseCovered[parent - 1] = true
                }
            }
            else
            {
                return 1
            }
        }
        reverseIndex = reverseIndex - 1
    }
    return 0
}

array<ReleaseSummary> AnalyzeFile(string path, int lineCount, int sourceStart, array<string> sourceLines, bool collectOnly, array<ReleaseSummary> externalReleaseSummaries)
{
    array<string> tokens = array<string>{}
    array<int> tokenLines = array<int>{}
    array<int> tokenScopes = array<int>{}
    string token = ""
    int tokenLine = 0
    int mode = 0
    bool escaped = false
    bool blockCommentSawStar = false

    for(lineIndex, 0, lineCount)
    {
        string sourceLine = sourceLines[sourceStart + lineIndex]
        int lineNumber = lineIndex + 1
        Length(sourceLine)
        int sourceLength = Length
        int column = 0
        bool lineContinuation = false
        while(column < sourceLength)
        {
            Substring(sourceLine, column, 1)
            string ch = Substring

            if(ch == "\\" && column + 1 == sourceLength)
            {
                if(mode == 1 && column > 0)
                {
                    Substring(sourceLine, column - 1, 1)
                    if(Substring == "*")
                    {
                        blockCommentSawStar = true
                    }
                }
                lineContinuation = true
                column = column + 1
                continue
            }

            if(mode == 1)
            {
                if(blockCommentSawStar && ch == "/")
                {
                    mode = 0
                    blockCommentSawStar = false
                    column = column + 1
                    continue
                }
                if(ch != "*")
                {
                    blockCommentSawStar = false
                }
                if(ch == "*" && column + 1 < sourceLength)
                {
                    Substring(sourceLine, column, 2)
                    string pair = Substring
                    if(pair == "*/")
                    {
                        mode = 0
                        blockCommentSawStar = false
                        column = column + 1
                    }
                }
                else if(ch == "*" && column + 1 == sourceLength)
                {
                    blockCommentSawStar = true
                }
                column = column + 1
                continue
            }

            if(mode == 2 || mode == 3)
            {
                if(escaped)
                {
                    escaped = false
                }
                else if(ch == "\\")
                {
                    escaped = true
                }
                else if((mode == 2 && ch == "\"") || (mode == 3 && ch == "'"))
                {
                    add(tokens, token)
                    add(tokenLines, tokenLine)
                    token = ""
                    mode = 0
                }
                column = column + 1
                continue
            }

            if(mode == 4)
            {
                column = sourceLength
                continue
            }

            if(ch == "/" && column + 1 < sourceLength)
            {
                Substring(sourceLine, column, 2)
                string pair = Substring
                if(pair == "//" || pair == "/*")
                {
                    if(token != "")
                    {
                        add(tokens, token)
                        add(tokenLines, tokenLine)
                        token = ""
                    }
                    if(pair == "//")
                    {
                        mode = 4
                    }
                    else
                    {
                        mode = 1
                    }
                    column = column + 2
                    continue
                }
            }

            if(ch == "\"" || ch == "'")
            {
                if(token != "")
                {
                    add(tokens, token)
                    add(tokenLines, tokenLine)
                    token = ""
                }
                if(ch == "\"")
                {
                    token = "__string_literal__"
                    mode = 2
                }
                else
                {
                    token = "__char_literal__"
                    mode = 3
                }
                tokenLine = lineNumber
                escaped = false
                column = column + 1
                continue
            }

            if(ch == " " || ch == "\t" || ch == "\r" || ch == "\n")
            {
                if(token != "")
                {
                    add(tokens, token)
                    add(tokenLines, tokenLine)
                    token = ""
                }
                column = column + 1
                continue
            }

            if(ch == "(" || ch == ")" || ch == "{" || ch == "}" || ch == "[" || ch == "]" || ch == "," || ch == ";" || ch == "=" || ch == "+" || ch == "-" || ch == "*" || ch == "&" || ch == "|" || ch == "!" || ch == "%" || ch == "<" || ch == ">" || ch == "?" || ch == "~" || ch == "^" || ch == ":" || ch == "." || ch == "#")
            {
                if(token != "")
                {
                    add(tokens, token)
                    add(tokenLines, tokenLine)
                    token = ""
                }
                add(tokens, ch)
                add(tokenLines, lineNumber)
                column = column + 1
                continue
            }

            if(token == "")
            {
                tokenLine = lineNumber
            }
            token = token + ch
            column = column + 1
        }

        if(token != "" && !lineContinuation)
        {
            add(tokens, token)
            add(tokenLines, tokenLine)
            token = ""
        }
        if(mode == 4 && !lineContinuation)
        {
            mode = 0
        }
    }

    Length(tokens)
    int tokenCount = Length
    int scopeDepth = 0
    int currentScope = 0
    int nextScope = 0
    for(scopeIndex, 0, tokenCount)
    {
        if(tokens[scopeIndex] == "{")
        {
            if(scopeDepth == 0)
            {
                nextScope = nextScope + 1
                currentScope = nextScope
            }
            scopeDepth = scopeDepth + 1
            add(tokenScopes, currentScope)
        }
        else if(tokens[scopeIndex] == "}")
        {
            add(tokenScopes, currentScope)
            if(scopeDepth > 0)
            {
                scopeDepth = scopeDepth - 1
                if(scopeDepth == 0)
                {
                    currentScope = 0
                }
            }
        }
        else
        {
            add(tokenScopes, currentScope)
        }
    }

    array<int> tokenLexicalScopes = array<int>{}
    array<int> lexicalScopeParents = array<int>{}
    array<int> lexicalScopeStack = array<int>{}
    for(scopeStackInit, 0, tokenCount + 1)
    {
        add(lexicalScopeStack, 0)
    }
    int lexicalDepth = 0
    int lexicalScope = 0
    int nextLexicalScope = 0
    for(lexicalIndex, 0, tokenCount)
    {
        if(tokens[lexicalIndex] == "{")
        {
            nextLexicalScope = nextLexicalScope + 1
            add(lexicalScopeParents, lexicalScope)
            lexicalScopeStack[lexicalDepth] = lexicalScope
            lexicalDepth = lexicalDepth + 1
            lexicalScope = nextLexicalScope
            add(tokenLexicalScopes, lexicalScope)
        }
        else if(tokens[lexicalIndex] == "}")
        {
            add(tokenLexicalScopes, lexicalScope)
            if(lexicalDepth > 0)
            {
                lexicalDepth = lexicalDepth - 1
                lexicalScope = lexicalScopeStack[lexicalDepth]
            }
        }
        else
        {
            add(tokenLexicalScopes, lexicalScope)
        }
    }

    array<int> tokenBranchIDs = array<int>{}
    array<int> tokenBranchArms = array<int>{}
    array<int> tokenLoopIDs = array<int>{}
    array<int> branchIfTokens = array<int>{}
    array<int> branchThenEnds = array<int>{}
    array<int> branchElseEnds = array<int>{}
    array<bool> branchHasElse = array<bool>{}
    array<string> branchNonNullNames = array<string>{}
    array<int> branchNonNullArms = array<int>{}
    array<int> branchParents = array<int>{}
    array<int> branchParentArms = array<int>{}
    array<int> branchStackIDs = array<int>{}
    array<int> branchStackArms = array<int>{}
    array<int> branchStackThenEnds = array<int>{}
    array<int> branchStackElseEnds = array<int>{}
    array<bool> branchStackHasElse = array<bool>{}
    array<int> loopStackIDs = array<int>{}
    array<int> loopStackEnds = array<int>{}
    for(stackInit, 0, tokenCount + 1)
    {
        add(branchStackIDs, 0)
        add(branchStackArms, 0)
        add(branchStackThenEnds, 0)
        add(branchStackElseEnds, 0)
        add(branchStackHasElse, false)
        add(loopStackIDs, 0)
        add(loopStackEnds, 0)
    }
    int branchStackCount = 0
    int loopStackCount = 0
    int nextLoopID = 0
    for(controlIndex, 0, tokenCount)
    {
        bool transitionBranch = true
        while(branchStackCount > 0 && transitionBranch)
        {
            int top = branchStackCount - 1
            if(branchStackArms[top] == 1 && branchStackHasElse[top] && controlIndex == branchStackThenEnds[top])
            {
                branchStackArms[top] = 2
                branchStackThenEnds[top] = branchStackElseEnds[top]
                transitionBranch = false
            }
            else if(controlIndex >= branchStackThenEnds[top])
            {
                branchStackCount = branchStackCount - 1
            }
            else
            {
                transitionBranch = false
            }
        }
        bool popLoop = true
        while(loopStackCount > 0 && popLoop)
        {
            int loopTop = loopStackCount - 1
            if(controlIndex >= loopStackEnds[loopTop])
            {
                loopStackCount = loopStackCount - 1
            }
            else
            {
                popLoop = false
            }
        }

        int currentBranch = 0
        int currentArm = 0
        if(branchStackCount > 0)
        {
            currentBranch = branchStackIDs[branchStackCount - 1]
            currentArm = branchStackArms[branchStackCount - 1]
        }
        int currentLoop = 0
        if(loopStackCount > 0)
        {
            currentLoop = loopStackIDs[loopStackCount - 1]
        }
        add(tokenBranchIDs, currentBranch)
        add(tokenBranchArms, currentArm)
        add(tokenLoopIDs, currentLoop)

        if(tokens[controlIndex] == "if")
        {
            int conditionScan = controlIndex + 1
            int conditionDepth = 0
            bool conditionEnded = false
            int bodyStart = tokenCount
            while(conditionScan < tokenCount && !conditionEnded)
            {
                if(tokens[conditionScan] == "(")
                {
                    conditionDepth = conditionDepth + 1
                }
                else if(tokens[conditionScan] == ")")
                {
                    conditionDepth = conditionDepth - 1
                    if(conditionDepth == 0)
                    {
                        bodyStart = conditionScan + 1
                        conditionEnded = true
                    }
                }
                conditionScan = conditionScan + 1
            }
            int thenEnd = tokenCount
            if(conditionEnded)
            {
                CStatementEnd(tokens, bodyStart, tokenCount)
                thenEnd = CStatementEnd
            }
            bool hasElse = thenEnd < tokenCount && tokens[thenEnd] == "else"
            int elseEnd = 0
            if(hasElse)
            {
                CStatementEnd(tokens, thenEnd + 1, tokenCount)
                elseEnd = CStatementEnd
            }
            Length(branchIfTokens)
            int branchID = Length + 1
            add(branchIfTokens, controlIndex)
            add(branchThenEnds, thenEnd)
            add(branchElseEnds, elseEnd)
            add(branchHasElse, hasElse)
            string nonNullName = ""
            int nonNullArm = 0
            int conditionStart = controlIndex + 2
            int conditionEnd = conditionScan - 2
            if(conditionEnd == conditionStart && tokens[conditionStart] != "!" && tokens[conditionStart] != "0")
            {
                nonNullName = tokens[conditionStart]
                nonNullArm = 1
            }
