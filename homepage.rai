    for(aliasIndex, 0, aliasCount)
    {
        if(aliasActive[aliasIndex] && aliasNames[aliasIndex] == aliasName && aliasFunctionScopes[aliasIndex] == functionScope)
        {
            GetLexicalScopeDistance(currentLexicalScope, aliasLexicalScopes[aliasIndex], lexicalScopeParents)
            int aliasDistance = GetLexicalScopeDistance
            if(aliasDistance >= 0 && aliasDistance < nearestDistance)
            {
                nearestDistance = aliasDistance
            }
        }
    }
    return nearestDistance
}

int IsResolvedAliasForCandidate(string aliasName, int candidateIndex, int functionScope, int currentLexicalScope, int currentBranch, int currentArm, array<string> aliasNames, array<int> aliasCandidates, array<int> aliasFunctionScopes, array<int> aliasLexicalScopes, array<int> aliasBranches, array<int> aliasArms, array<bool> aliasActive, array<int> lexicalScopeParents, array<int> branchParents, array<int> branchParentArms)
{
    int nearestDistance = 2147483647
    Length(aliasNames)
    int aliasCount = Length
    for(aliasIndex, 0, aliasCount)
    {
        if(aliasActive[aliasIndex] && aliasNames[aliasIndex] == aliasName && aliasFunctionScopes[aliasIndex] == functionScope)
        {
            GetLexicalScopeDistance(currentLexicalScope, aliasLexicalScopes[aliasIndex], lexicalScopeParents)
            int aliasDistance = GetLexicalScopeDistance
            IsBranchContextWithin(currentBranch, currentArm, aliasBranches[aliasIndex], aliasArms[aliasIndex], branchParents, branchParentArms)
            int aliasPathMatches = IsBranchContextWithin
            if(aliasDistance >= 0 && aliasPathMatches == 1 && aliasDistance < nearestDistance)
            {
                nearestDistance = aliasDistance
            }
        }
    }
    for(aliasIndex, 0, aliasCount)
    {
        if(aliasActive[aliasIndex] && aliasNames[aliasIndex] == aliasName && aliasFunctionScopes[aliasIndex] == functionScope && aliasCandidates[aliasIndex] == candidateIndex)
        {
            GetLexicalScopeDistance(currentLexicalScope, aliasLexicalScopes[aliasIndex], lexicalScopeParents)
            int aliasDistance = GetLexicalScopeDistance
            IsBranchContextWithin(currentBranch, currentArm, aliasBranches[aliasIndex], aliasArms[aliasIndex], branchParents, branchParentArms)
            int aliasPathMatches = IsBranchContextWithin
            if(aliasDistance == nearestDistance && aliasPathMatches == 1)
            {
                return 1
            }
        }
    }
    return 0
}

int IsPotentialAliasForCandidate(string aliasName, int candidateIndex, int functionScope, int currentLexicalScope, int currentBranch, int currentArm, array<string> aliasNames, array<int> aliasCandidates, array<int> aliasFunctionScopes, array<int> aliasLexicalScopes, array<int> aliasBranches, array<int> aliasArms, array<bool> aliasActive, array<int> lexicalScopeParents, array<int> branchParents, array<int> branchParentArms)
