        if(tokens[scan] == name && tokenScopes[scan] == scope && scan + 1 < before && (tokens[scan + 1] == ";" || tokens[scan + 1] == "=") && (tokens[scan - 1] == "char" || tokens[scan - 1] == "int" || tokens[scan - 1] == "long" || tokens[scan - 1] == "short" || tokens[scan - 1] == "float" || tokens[scan - 1] == "double" || tokens[scan - 1] == "const" || tokens[scan - 1] == "volatile"))
        {
            return 1
        }
        scan = scan - 1
    }
    return 0
}

int IsStringLiteralObject(string name, int scope, int before, array<string> tokens, array<int> tokenScopes)
{
    string currentName = name
    int currentBefore = before
    for(chainDepth, 0, 8)
    {
        bool foundBinding = false
        int scan = currentBefore - 1
        while(scan >= 2)
        {
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 2 < currentBefore && tokens[scan + 1] == "=" && tokens[scan + 2] == "__string_literal__")
            {
                return 1
            }
            if(tokens[scan] == currentName && tokenScopes[scan] == scope && scan + 2 < currentBefore && tokens[scan + 1] == "=" && tokens[scan + 2] != "[")
            {
                currentName = tokens[scan + 2]
                currentBefore = scan
                foundBinding = true
                break
            }
            scan = scan - 1
        }
        if(!foundBinding)
        {
            return 0
        }
    }
    return 0
}

int IsPosixMemalignOutputToken(string name, int tokenIndex, int scope, array<string> tokens, array<int> tokenScopes)
