            int aliasDistance = GetLexicalScopeDistance
            BranchContextsMayOverlap(currentBranch, currentArm, aliasBranches[aliasIndex], aliasArms[aliasIndex], branchParents, branchParentArms)
            int aliasPathMayMatch = BranchContextsMayOverlap
            if(aliasDistance >= 0 && aliasPathMayMatch == 1 && aliasDistance < nearestDistance)
