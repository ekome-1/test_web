                        functionParamsEnded = true
                    }
                }
                functionScan = functionScan + 1
            }
            if(functionParamsEnded && functionCloseParen + 1 < tokenCount && tokens[functionCloseParen + 1] == "{")
            {
                string storedParameterName = ""
                int parameterStart = functionIndex + 2
                int parameterDepth = 0
                int parameterIndex = 0
                int parameterScan = parameterStart
                while(parameterScan <= functionCloseParen)
                {
                    if(tokens[parameterScan] == "(" || tokens[parameterScan] == "[")
                    {
                        parameterDepth = parameterDepth + 1
                    }
                    else if(tokens[parameterScan] == ")" || tokens[parameterScan] == "]")
                    {
                        if(parameterDepth > 0)
                        {
                            parameterDepth = parameterDepth - 1
                        }
                    }
                    if((tokens[parameterScan] == "," && parameterDepth == 0) || parameterScan == functionCloseParen)
                    {
                        CParameterName(tokens, parameterStart, parameterScan)
                        string parameterName = CParameterName
                        if(parameterIndex == requestedParameter)
                        {
                            storedParameterName = parameterName
                        }
                        parameterIndex = parameterIndex + 1
                        parameterStart = parameterScan + 1
                    }
                    parameterScan = parameterScan + 1
                }
                if(storedParameterName != "")
                {
                    CStatementEnd(tokens, functionCloseParen + 1, tokenCount)
                    int functionBodyEnd = CStatementEnd
                    int functionScope = tokenScopes[functionCloseParen + 1]
                    array<string> storedAliasNames = array<string>{}
                    array<bool> storedAliasActive = array<bool>{}
                    int bodyScan = functionCloseParen + 2
                    while(bodyScan < functionBodyEnd)
                    {
                        if(tokens[bodyScan] == "=" && bodyScan > 0 && bodyScan + 1 < functionBodyEnd)
                        {
                            string targetName = tokens[bodyScan - 1]
                            bool sourceIsStoredParameter = tokens[bodyScan + 1] == storedParameterName
                            bool sourceIsStoredAlias = false
                            Length(storedAliasNames)
                            int storedAliasCount = Length
                            for(storedAliasIndex, 0, storedAliasCount)
                            {
                                if(storedAliasActive[storedAliasIndex] && tokens[bodyScan + 1] == storedAliasNames[storedAliasIndex])
                                {
                                    sourceIsStoredAlias = true
                                }
                            }
                            bool sourceCarriesStoredPointer = sourceIsStoredParameter || sourceIsStoredAlias
                            bool targetIsMember = false
                            if(bodyScan >= 3 && tokens[bodyScan - 2] == ".")
                            {
                                targetName = tokens[bodyScan - 3]
                                targetIsMember = true
                            }
                            else if(bodyScan >= 4 && tokens[bodyScan - 2] == ">" && tokens[bodyScan - 3] == "-")
                            {
                                targetName = tokens[bodyScan - 4]
                                targetIsMember = true
                            }
                            if(sourceCarriesStoredPointer)
                            {
                                IsGlobalStorageTarget(targetName, bodyScan, functionScope, tokens, tokenScopes)
                                int globalStorageTarget = IsGlobalStorageTarget
                                if(globalStorageTarget == 1)
                                {
                                    return 1
                                }
                                if(!targetIsMember && targetName != "*" && targetName != "&" && tokenScopes[bodyScan - 1] == functionScope)
                                {
                                    bool knownStoredAlias = false
                                    for(storedAliasCheck, 0, storedAliasCount)
                                    {
                                        if(storedAliasNames[storedAliasCheck] == targetName)
                                        {
                                            storedAliasActive[storedAliasCheck] = true
                                            knownStoredAlias = true
                                        }
                                    }
                                    if(!knownStoredAlias)
                                    {
                                        add(storedAliasNames, targetName)
                                        add(storedAliasActive, true)
                                    }
                                }
                            }
                            else if(!targetIsMember && targetName != "*" && targetName != "&")
                            {
                                for(storedAliasClear, 0, storedAliasCount)
                                {
                                    if(storedAliasNames[storedAliasClear] == targetName && tokenScopes[bodyScan - 1] == functionScope)
                                    {
                                        storedAliasActive[storedAliasClear] = false
                                    }
                                }
                            }
                        }
                        bodyScan = bodyScan + 1
                    }
                }
            }
        }
        functionIndex = functionIndex + 1
    }
    return 0
}

int IsPointerParameterReleased(string functionName, int requestedParameter, int tokenCount, array<string> tokens, array<int> tokenScopes, array<int> tokenBranchIDs, array<int> tokenBranchArms, array<int> branchParents, array<bool> branchHasElse)
{
    int functionIndex = 0
    while(functionIndex < tokenCount)
    {
        if(tokenScopes[functionIndex] == 0 && tokens[functionIndex] == functionName && functionIndex + 2 < tokenCount && tokens[functionIndex + 1] == "(")
        {
