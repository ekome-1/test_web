                if(tokens[functionScan] == "(")
                {
                    functionParenDepth = functionParenDepth + 1
                }
                else if(tokens[functionScan] == ")")
                {
                    functionParenDepth = functionParenDepth - 1
                    if(functionParenDepth == 0)
                    {
                        functionCloseParen = functionScan
                        functionParamsEnded = true
                    }
                }
                functionScan = functionScan + 1
            }
            if(functionParamsEnded && functionCloseParen + 1 < tokenCount && tokens[functionCloseParen + 1] == "{")
            {
                string outputParameterName = ""
                int parameterStart = functionIndex + 2
                int parameterDepth = 0
                int parameterIndex = 0
                int parameterScan = parameterStart
                while(parameterScan <= functionCloseParen)
                {
                    if(tokens[parameterScan] == "(" || tokens[parameterScan] == "[")
                    {
                        parameterDepth = parameterDepth + 1
                    }
                    else if(tokens[parameterScan] == ")" || tokens[parameterScan] == "]")
                    {
                        if(parameterDepth > 0)
                        {
                            parameterDepth = parameterDepth - 1
                        }
                    }
                    if((tokens[parameterScan] == "," && parameterDepth == 0) || parameterScan == functionCloseParen)
                    {
                        CParameterName(tokens, parameterStart, parameterScan)
                        string parameterName = CParameterName
                        if(parameterIndex == requestedParameter)
                        {
                            outputParameterName = parameterName
                        }
                        parameterIndex = parameterIndex + 1
                        parameterStart = parameterScan + 1
                    }
                    parameterScan = parameterScan + 1
                }
                if(outputParameterName != "")
                {
                    CStatementEnd(tokens, functionCloseParen + 1, tokenCount)
                    int functionBodyEnd = CStatementEnd
                    int functionScope = tokenScopes[functionCloseParen + 1]
                    array<string> outputAliasNames = array<string>{}
                    array<int> outputAliasScopes = array<int>{}
                    array<bool> outputAliasActive = array<bool>{}
                    int bodyScan = functionCloseParen + 2
                    while(bodyScan < functionBodyEnd)
                    {
                        if(tokens[bodyScan] == "=" && bodyScan > 0 && bodyScan + 1 < functionBodyEnd)
                        {
                            string outputAliasTarget = tokens[bodyScan - 1]
                            bool outputAliasTargetIsMember = false
                            if(bodyScan >= 3 && tokens[bodyScan - 2] == ".")
                            {
                                outputAliasTarget = tokens[bodyScan - 3]
                                outputAliasTargetIsMember = true
                            }
                            else if(bodyScan >= 4 && tokens[bodyScan - 2] == ">" && tokens[bodyScan - 3] == "-")
                            {
                                outputAliasTarget = tokens[bodyScan - 4]
                                outputAliasTargetIsMember = true
                            }
                            bool outputAliasSourceIsStack = false
                            IsStackArrayObject(tokens[bodyScan + 1], tokenScopes[bodyScan], bodyScan + 1, tokens, tokenScopes)
                            int outputAliasStackArray = IsStackArrayObject
                            IsStackScalarObject(tokens[bodyScan + 1], tokenScopes[bodyScan], bodyScan + 1, tokens, tokenScopes)
                            int outputAliasStackScalar = IsStackScalarObject
                            if(outputAliasStackArray == 1 || outputAliasStackScalar == 1)
                            {
                                outputAliasSourceIsStack = true
                            }
                            Length(outputAliasNames)
                            int outputAliasCount = Length
                            for(outputAliasSourceIndex, 0, outputAliasCount)
                            {
                                if(outputAliasActive[outputAliasSourceIndex] && outputAliasNames[outputAliasSourceIndex] == tokens[bodyScan + 1] && outputAliasScopes[outputAliasSourceIndex] <= tokenScopes[bodyScan])
                                {
                                    outputAliasSourceIsStack = true
                                }
                            }
                            if(outputAliasSourceIsStack && !outputAliasTargetIsMember && outputAliasTarget != "*" && outputAliasTarget != "&" && tokenScopes[bodyScan - 1] >= functionScope)
                            {
                                bool knownOutputAlias = false
                                for(outputAliasCheck, 0, outputAliasCount)
                                {
                                    if(outputAliasNames[outputAliasCheck] == outputAliasTarget && outputAliasScopes[outputAliasCheck] == tokenScopes[bodyScan - 1])
                                    {
                                        outputAliasActive[outputAliasCheck] = true
                                        knownOutputAlias = true
                                    }
                                }
                                if(!knownOutputAlias)
                                {
                                    add(outputAliasNames, outputAliasTarget)
                                    add(outputAliasScopes, tokenScopes[bodyScan - 1])
                                    add(outputAliasActive, true)
                                }
                            }
                            else if(!outputAliasTargetIsMember && outputAliasTarget != "*" && outputAliasTarget != "&")
                            {
                                for(outputAliasClear, 0, outputAliasCount)
                                {
                                    if(outputAliasNames[outputAliasClear] == outputAliasTarget && outputAliasScopes[outputAliasClear] == tokenScopes[bodyScan - 1])
                                    {
                                        outputAliasActive[outputAliasClear] = false
                                    }
                                }
                            }
                        }
                        if(tokens[bodyScan] == "*" && bodyScan + 3 < functionBodyEnd && tokens[bodyScan + 1] == outputParameterName && tokens[bodyScan + 2] == "=")
                        {
                            int outputSourceIndex = bodyScan + 3
                            IsStackArrayObject(tokens[outputSourceIndex], tokenScopes[outputSourceIndex], outputSourceIndex, tokens, tokenScopes)
                            int outputStackArray = IsStackArrayObject
                            IsStackScalarObject(tokens[outputSourceIndex], tokenScopes[outputSourceIndex], outputSourceIndex, tokens, tokenScopes)
                            int outputStackScalar = IsStackScalarObject
                            bool outputSourceIsStack = outputStackArray == 1 || outputStackScalar == 1
                            Length(outputAliasNames)
                            int outputAliasCountForOutput = Length
                            for(outputAliasOutputIndex, 0, outputAliasCountForOutput)
                            {
                                if(outputAliasActive[outputAliasOutputIndex] && outputAliasNames[outputAliasOutputIndex] == tokens[outputSourceIndex] && outputAliasScopes[outputAliasOutputIndex] <= tokenScopes[outputSourceIndex])
                                {
                                    outputSourceIsStack = true
                                }
                            }
                            if(outputSourceIsStack)
                            {
                                return outputSourceIndex
                            }
                            if(tokens[outputSourceIndex] == "&" && outputSourceIndex + 1 < functionBodyEnd)
                            {
                                IsStackScalarObject(tokens[outputSourceIndex + 1], tokenScopes[outputSourceIndex + 1], outputSourceIndex + 1, tokens, tokenScopes)
                                int outputAddressedScalar = IsStackScalarObject
                                if(outputAddressedScalar == 1)
                                {
                                    return outputSourceIndex + 1
                                }
                            }
                        }
                        bodyScan = bodyScan + 1
                    }
                }
            }
        }
        functionIndex = functionIndex + 1
    }
    return -1
}

int IsBranchContextWithin(int currentGroup, int currentArm, int expectedGroup, int expectedArm, array<int> branchParents, array<int> branchParentArms)
{
    if(expectedGroup == 0)
    {
        return 1
    }
    int group = currentGroup
    int arm = currentArm
    while(group > 0)
    {
        if(group == expectedGroup)
        {
            if(arm == expectedArm)
            {
                return 1
            }
            return 0
        }
        arm = branchParentArms[group - 1]
        group = branchParents[group - 1]
    }
    return 0
}

int BranchContextsMayOverlap(int firstGroup, int firstArm, int secondGroup, int secondArm, array<int> branchParents, array<int> branchParentArms)
{
    int firstPathGroup = firstGroup
    int firstPathArm = firstArm
    while(firstPathGroup > 0)
    {
        int secondPathGroup = secondGroup
        int secondPathArm = secondArm
        while(secondPathGroup > 0)
        {
            if(firstPathGroup == secondPathGroup && firstPathArm != secondPathArm)
            {
                return 0
            }
            secondPathArm = branchParentArms[secondPathGroup - 1]
            secondPathGroup = branchParents[secondPathGroup - 1]
        }
        firstPathArm = branchParentArms[firstPathGroup - 1]
        firstPathGroup = branchParents[firstPathGroup - 1]
    }
    return 1
}

int MayRepeatReleaseAcrossLoopIterations(string pointerName, int loopID, int currentToken, int tokenCount, array<string> tokens, array<int> tokenLoopIDs)
{
    if(loopID <= 0)
    {
        return 0
    }
    int loopStart = tokenCount
    int loopEnd = -1
    int scan = 0
    while(scan < tokenCount)
    {
        if(tokenLoopIDs[scan] == loopID)
        {
            if(scan < loopStart)
            {
                loopStart = scan
            }
            loopEnd = scan
        }
        scan = scan + 1
    }
    if(loopEnd < currentToken)
    {
        return 0
    }
    scan = loopStart
    while(scan <= loopEnd)
    {
        if(tokens[scan] == pointerName)
        {
            if(scan + 1 <= loopEnd)
            {
                if(tokens[scan + 1] == "=")
                {
                    return 0
                }
            }
        }
        if(tokenLoopIDs[scan] == loopID && (tokens[scan] == "break" || tokens[scan] == "return"))
        {
            return 0
        }
        if(scan != currentToken && tokenLoopIDs[scan] == loopID && tokens[scan] == "free")
        {
            if(scan + 3 <= loopEnd)
            {
                if(tokens[scan + 1] == "(" && tokens[scan + 2] == pointerName && tokens[scan + 3] == ")")
                {
                    return 0
                }
            }
        }
        scan = scan + 1
    }
    return 1
}

int IsSimpleTerminatingArm(int armStart, int armEnd, array<string> tokens)
{
    int scan = armStart
    if(scan < armEnd && tokens[scan] == "{")
    {
        scan = scan + 1
    }
    if(scan < armEnd && tokens[scan] == "return")
    {
        return 1
    }
    if(scan + 1 < armEnd && (tokens[scan] == "abort" || tokens[scan] == "exit" || tokens[scan] == "_Exit" || tokens[scan] == "quick_exit" || tokens[scan] == "__builtin_unreachable") && tokens[scan + 1] == "(")
    {
        return 1
    }
    return 0
}

int IsGotoCleanupExclusive(int previousFreeToken, int currentFreeToken, array<string> tokens, array<int> tokenScopes)
{
    if(currentFreeToken < 2 || tokens[currentFreeToken - 1] != ":")
    {
        return 0
    }
    string cleanupLabel = tokens[currentFreeToken - 2]
    if(currentFreeToken <= previousFreeToken + 2)
    {
        return 0
    }
    bool fallthroughTerminates = false
    int scan = previousFreeToken + 1
    while(scan < currentFreeToken - 2)
    {
        if(tokens[scan] == "return" && tokenScopes[scan] == tokenScopes[previousFreeToken])
        {
            fallthroughTerminates = true
        }
        scan = scan + 1
    }
    if(!fallthroughTerminates)
    {
        return 0
    }
    scan = 0
    while(scan < previousFreeToken)
    {
        if(tokens[scan] == "goto" && scan + 1 < previousFreeToken && tokens[scan + 1] == cleanupLabel && tokenScopes[scan] == tokenScopes[previousFreeToken])
        {
            return 1
        }
        scan = scan + 1
    }
    return 0
}

int HasPartialGotoRelease(int candidateIndex, array<string> allocationNames, int allocationToken, int functionScope, int tokenCount, array<string> tokens, array<int> tokenScopes, array<int> tokenBranchIDs, array<int> releasedAllocationIndexes, array<int> releasedAllocationTokens, array<int> releaseCandidates, array<int> releaseTokens)
{
    int gotoScan = allocationToken + 1
    while(gotoScan + 1 < tokenCount)
    {
        if(tokens[gotoScan] == "goto" && tokenBranchIDs[gotoScan] > 0)
        {
            string cleanupLabel = tokens[gotoScan + 1]
            int labelScan = gotoScan + 2
            while(labelScan + 1 < tokenCount && !(tokens[labelScan] == cleanupLabel && tokens[labelScan + 1] == ":" && tokenScopes[labelScan] == functionScope))
            {
                labelScan = labelScan + 1
            }
            if(labelScan + 1 < tokenCount && tokens[labelScan] == cleanupLabel && tokens[labelScan + 1] == ":")
            {
                Length(releasedAllocationIndexes)
                int releaseCount = Length
                bool releaseAtCleanup = false
                int releaseScan = 0
                while(releaseScan < releaseCount)
                {
                    if(releasedAllocationIndexes[releaseScan] == candidateIndex && releasedAllocationTokens[releaseScan] > labelScan && releasedAllocationTokens[releaseScan] < tokenCount && tokenScopes[releasedAllocationTokens[releaseScan]] == functionScope)
                    {
                        releaseAtCleanup = true
                    }
                    releaseScan = releaseScan + 1
                }
                if(releaseAtCleanup)
                {
                    int pathScan = gotoScan + 2
                    while(pathScan < labelScan)
                    {
                        if(tokens[pathScan] == "return" && tokenScopes[pathScan] == functionScope)
                        {
                            bool returnsAllocation = false
                            string returnedName = tokens[pathScan + 1]
                            string currentReturnName = returnedName
                            int currentReturnBefore = pathScan
                            for(returnChainDepth, 0, 8)
                            {
                                if(currentReturnName == allocationNames[candidateIndex])
                                {
                                    returnsAllocation = true
                                }
                                bool foundReturnBinding = false
                                int returnBindingScan = currentReturnBefore - 1
                                while(returnBindingScan >= 2)
                                {
                                    if(tokens[returnBindingScan] == currentReturnName && tokenScopes[returnBindingScan] == functionScope && returnBindingScan + 2 < currentReturnBefore && tokens[returnBindingScan + 1] == "=" && tokens[returnBindingScan + 2] != "[")
                                    {
                                        currentReturnName = tokens[returnBindingScan + 2]
                                        currentReturnBefore = returnBindingScan
                                        foundReturnBinding = true
                                        break
                                    }
                                    returnBindingScan = returnBindingScan - 1
                                }
                                if(!foundReturnBinding)
                                {
                                    break
                                }
                            }
                            if(returnsAllocation)
                            {
                                pathScan = pathScan + 1
                                continue
                            }
                            bool releasedBeforeReturn = false
                            releaseScan = 0
                            Length(releaseCandidates)
                            int pathReleaseCount = Length
                            while(releaseScan < pathReleaseCount)
                            {
                                if(releaseCandidates[releaseScan] == candidateIndex && releaseTokens[releaseScan] > gotoScan && releaseTokens[releaseScan] < pathScan)
                                {
                                    releasedBeforeReturn = true
                                }
                                releaseScan = releaseScan + 1
                            }
                            if(!releasedBeforeReturn)
                            {
                                return 1
                            }
                        }
                        pathScan = pathScan + 1
                    }
                }
            }
        }
        gotoScan = gotoScan + 1
    }
    return 0
}

int IsSwitchCaseExclusive(int previousFreeToken, int currentFreeToken, array<string> tokens, array<int> tokenScopes)
{
    if(currentFreeToken <= previousFreeToken || tokenScopes[previousFreeToken] != tokenScopes[currentFreeToken])
    {
        return 0
    }
    int previousCase = -1
    int scan = previousFreeToken - 1
    while(scan >= 0 && previousCase < 0)
    {
        if((tokens[scan] == "case" || tokens[scan] == "default") && tokenScopes[scan] == tokenScopes[previousFreeToken])
        {
            previousCase = scan
        }
        scan = scan - 1
    }
    int currentCase = -1
    scan = currentFreeToken - 1
    while(scan >= 0 && currentCase < 0)
    {
        if((tokens[scan] == "case" || tokens[scan] == "default") && tokenScopes[scan] == tokenScopes[currentFreeToken])
        {
            currentCase = scan
        }
        scan = scan - 1
    }
    if(previousCase < 0 || currentCase <= previousCase)
    {
        return 0
    }
    scan = previousFreeToken + 1
    while(scan < currentCase)
    {
        if(tokens[scan] == "break" && tokenScopes[scan] == tokenScopes[previousFreeToken])
        {
            return 1
        }
        scan = scan + 1
    }
    return 0
}

int HasPartialSwitchRelease(int candidateIndex, int allocationToken, int functionScope, int tokenCount, array<string> tokens, array<int> tokenScopes, array<int> releasedAllocationIndexes, array<int> releasedAllocationTokens)
{
    int switchScan = allocationToken + 1
    while(switchScan < tokenCount)
    {
        if(tokens[switchScan] == "switch" && tokenScopes[switchScan] == functionScope)
        {
            int bodyBrace = switchScan + 1
            while(bodyBrace < tokenCount && tokens[bodyBrace] != "{" && tokens[bodyBrace] != ";")
            {
                bodyBrace = bodyBrace + 1
            }
            if(bodyBrace < tokenCount && tokens[bodyBrace] == "{")
            {
                int bodyEnd = bodyBrace + 1
                int braceDepth = 1
                while(bodyEnd < tokenCount && braceDepth > 0)
                {
                    if(tokens[bodyEnd] == "{")
                    {
                        braceDepth = braceDepth + 1
                    }
                    else if(tokens[bodyEnd] == "}")
                    {
                        braceDepth = braceDepth - 1
                    }
                    bodyEnd = bodyEnd + 1
                }
                int closingBrace = bodyEnd - 1
                if(closingBrace > bodyBrace)
                {
                    int bodyScope = tokenScopes[bodyBrace + 1]
                    int firstCase = -1
                    int caseCount = 0
                    int scan = bodyBrace + 1
                    while(scan < closingBrace)
                    {
                        if((tokens[scan] == "case" || tokens[scan] == "default") && tokenScopes[scan] == bodyScope)
                        {
                            if(firstCase < 0)
                            {
                                firstCase = scan
                            }
                            caseCount = caseCount + 1
                        }
                        scan = scan + 1
                    }
                    if(firstCase >= 0 && caseCount > 0)
                    {
                        int releasedCaseCount = 0
                        int missingCaseCount = 0
                        bool hasDefault = false
                        int caseStart = firstCase
                        while(caseStart < closingBrace)
                        {
                            if(tokens[caseStart] == "default")
                            {
                                hasDefault = true
                            }
                            int caseEnd = caseStart + 1
                            while(caseEnd < closingBrace && !((tokens[caseEnd] == "case" || tokens[caseEnd] == "default") && tokenScopes[caseEnd] == bodyScope))
                            {
                                caseEnd = caseEnd + 1
                            }
                            bool caseReleased = false
                            Length(releasedAllocationIndexes)
                            int releaseCount = Length
                            int releaseScan = 0
                            while(releaseScan < releaseCount)
                            {
                                if(releasedAllocationIndexes[releaseScan] == candidateIndex && releasedAllocationTokens[releaseScan] >= caseStart && releasedAllocationTokens[releaseScan] < caseEnd && tokenScopes[releasedAllocationTokens[releaseScan]] == bodyScope)
                                {
                                    caseReleased = true
                                }
                                releaseScan = releaseScan + 1
                            }
                            if(!caseReleased && caseEnd < closingBrace)
                            {
                                releaseScan = 0
                                while(releaseScan < releaseCount)
                                {
                                    if(releasedAllocationIndexes[releaseScan] == candidateIndex && releasedAllocationTokens[releaseScan] >= caseEnd && releasedAllocationTokens[releaseScan] < closingBrace && tokenScopes[releasedAllocationTokens[releaseScan]] == bodyScope)
                                    {
                                        bool fallthroughBlocked = false
                                        int blockScan = caseStart
                                        while(blockScan < releasedAllocationTokens[releaseScan])
                                        {
                                            if(tokenScopes[blockScan] == bodyScope && (tokens[blockScan] == "break" || tokens[blockScan] == "return" || tokens[blockScan] == "goto"))
                                            {
                                                fallthroughBlocked = true
                                            }
                                            blockScan = blockScan + 1
                                        }
                                        if(!fallthroughBlocked)
                                        {
                                            caseReleased = true
                                        }
                                    }
                                    releaseScan = releaseScan + 1
                                }
                            }
                            if(caseReleased)
                            {
                                releasedCaseCount = releasedCaseCount + 1
                            }
                            else
                            {
                                missingCaseCount = missingCaseCount + 1
                            }
                            caseStart = caseEnd
                        }
                        if(!hasDefault)
                        {
                            missingCaseCount = missingCaseCount + 1
                        }
                        Length(releasedAllocationIndexes)
                        int releaseAfterSwitchCount = Length
                        int releaseAfterSwitchScan = 0
                        while(releaseAfterSwitchScan < releaseAfterSwitchCount)
                        {
                            if(releasedAllocationIndexes[releaseAfterSwitchScan] == candidateIndex && releasedAllocationTokens[releaseAfterSwitchScan] > closingBrace && releasedAllocationTokens[releaseAfterSwitchScan] < tokenCount && tokenScopes[releasedAllocationTokens[releaseAfterSwitchScan]] == functionScope)
                            {
                                return 0
                            }
                            releaseAfterSwitchScan = releaseAfterSwitchScan + 1
                        }
                        if(releasedCaseCount > 0 && missingCaseCount > 0)
                        {
                            return 1
                        }
                    }
                }
            }
        }
        switchScan = switchScan + 1
    }
    return 0
}

int IsNonNullAfterEarlyNullExit(string pointerName, int functionScope, int currentToken, array<string> tokens, array<int> tokenScopes, array<int> branchIfTokens, array<int> branchThenEnds, array<int> branchElseEnds, array<bool> branchHasElse, array<string> branchNonNullNames, array<int> branchNonNullArms)
{
    Length(branchIfTokens)
    int branchCount = Length
    for(branchIndex, 0, branchCount)
    {
        if(branchNonNullNames[branchIndex] != pointerName || branchNonNullArms[branchIndex] == 0 || tokenScopes[branchIfTokens[branchIndex]] != functionScope || branchIfTokens[branchIndex] >= currentToken)
        {
            continue
        }
        int conditionScan = branchIfTokens[branchIndex] + 1
        int conditionDepth = 0
        bool conditionEnded = false
        int bodyStart = currentToken
        while(conditionScan < currentToken && !conditionEnded)
        {
            if(tokens[conditionScan] == "(")
            {
                conditionDepth = conditionDepth + 1
            }
            else if(tokens[conditionScan] == ")")
            {
                conditionDepth = conditionDepth - 1
                if(conditionDepth == 0)
                {
                    bodyStart = conditionScan + 1
                    conditionEnded = true
                }
            }
            conditionScan = conditionScan + 1
        }
        if(!conditionEnded)
        {
            continue
        }
        int thenEnd = branchThenEnds[branchIndex]
        if(!branchHasElse[branchIndex])
        {
            IsSimpleTerminatingArm(bodyStart, thenEnd, tokens)
            int thenArmReturns = IsSimpleTerminatingArm
            if(branchNonNullArms[branchIndex] == 2 && currentToken >= thenEnd && thenArmReturns == 1)
            {
                return 1
            }
        }
        else if(currentToken >= branchElseEnds[branchIndex])
        {
            int nullArmTerminates = 0
            IsSimpleTerminatingArm(thenEnd + 1, branchElseEnds[branchIndex], tokens)
            int elseArmReturns = IsSimpleTerminatingArm
            IsSimpleTerminatingArm(bodyStart, thenEnd, tokens)
            int thenArmReturnsWithElse = IsSimpleTerminatingArm
            if(branchNonNullArms[branchIndex] == 1 && elseArmReturns == 1)
            {
                nullArmTerminates = 1
            }
            if(branchNonNullArms[branchIndex] == 2 && thenArmReturnsWithElse == 1)
            {
                nullArmTerminates = 1
            }
            if(nullArmTerminates == 1)
            {
                return 1
            }
        }
    }
    return 0
}

int IsNonNullGuardForName(array<string> branchNonNullNames, array<int> branchNonNullArms, int branchID, int branchArm, string pointerName)
{
    Length(branchNonNullNames)
    int branchCount = Length
    if(branchID > 0 && branchID <= branchCount && branchNonNullNames[branchID - 1] == pointerName && branchNonNullArms[branchID - 1] == branchArm)
    {
        return 1
    }
    return 0
}

int IsNullGuardForName(array<string> branchNonNullNames, array<int> branchNonNullArms, int branchID, int branchArm, string pointerName)
{
    Length(branchNonNullNames)
    int branchCount = Length
    if(branchID > 0 && branchID <= branchCount && branchNonNullNames[branchID - 1] == pointerName && branchNonNullArms[branchID - 1] != branchArm)
    {
        return 1
    }
    return 0
}

int IsPointerReassignedOnPath(string pointerName, int pointerScope, int afterToken, int beforeToken, int currentBranch, int currentArm, array<string> assignmentNames, array<int> assignmentScopes, array<int> assignmentTokens, array<int> assignmentBranches, array<int> assignmentArms, array<int> branchIfTokens, array<bool> branchHasElse, array<int> branchParents, array<int> branchParentArms)
{
    Length(assignmentNames)
    int assignmentCount = Length
    for(assignmentIndex, 0, assignmentCount)
    {
        if(assignmentNames[assignmentIndex] == pointerName && assignmentScopes[assignmentIndex] == pointerScope && assignmentTokens[assignmentIndex] > afterToken && assignmentTokens[assignmentIndex] < beforeToken)
        {
            if(assignmentBranches[assignmentIndex] == 0)
            {
                return 1
            }
            IsBranchContextWithin(currentBranch, currentArm, assignmentBranches[assignmentIndex], assignmentArms[assignmentIndex], branchParents, branchParentArms)
            int assignmentOnCurrentPath = IsBranchContextWithin
            if(assignmentOnCurrentPath == 1)
            {
                return 1
            }
        }
    }

    Length(branchHasElse)
    int branchCount = Length
    for(branchIndex, 0, branchCount)
    {
        if(branchParents[branchIndex] == 0 && branchHasElse[branchIndex] && branchIfTokens[branchIndex] > afterToken && branchIfTokens[branchIndex] < beforeToken)
        {
            bool assignedThen = false
            bool assignedElse = false
            for(assignmentIndex, 0, assignmentCount)
            {
                if(assignmentNames[assignmentIndex] == pointerName && assignmentScopes[assignmentIndex] == pointerScope && assignmentTokens[assignmentIndex] > afterToken && assignmentTokens[assignmentIndex] < beforeToken && assignmentBranches[assignmentIndex] == branchIndex + 1)
                {
                    if(assignmentArms[assignmentIndex] == 1)
                    {
                        assignedThen = true
                    }
                    else if(assignmentArms[assignmentIndex] == 2)
                    {
                        assignedElse = true
                    }
                }
            }
            if(assignedThen && assignedElse)
            {
                return 1
            }
        }
    }
    return 0
}

int GetLexicalScopeDistance(int currentScope, int declarationScope, array<int> lexicalScopeParents)
{
    int scope = currentScope
    int distance = 0
    while(scope > 0)
    {
        if(scope == declarationScope)
        {
            return distance
        }
        scope = lexicalScopeParents[scope - 1]
        distance = distance + 1
    }
    return -1
}

int GetNearestAllocationDistance(string pointerName, int functionScope, int beforeToken, int currentLexicalScope, int maximumDistance, array<string> allocationNames, array<int> allocationFunctionScopes, array<int> allocationTokens, array<int> allocationLexicalScopes, array<int> lexicalScopeParents)
{
    int nearestDistance = maximumDistance
    Length(allocationNames)
    int candidateCount = Length
    for(candidateIndex, 0, candidateCount)
    {
        if(allocationNames[candidateIndex] == pointerName && allocationFunctionScopes[candidateIndex] == functionScope && allocationTokens[candidateIndex] < beforeToken)
        {
            GetLexicalScopeDistance(currentLexicalScope, allocationLexicalScopes[candidateIndex], lexicalScopeParents)
            int candidateDistance = GetLexicalScopeDistance
            if(candidateDistance >= 0 && candidateDistance < nearestDistance)
            {
                nearestDistance = candidateDistance
            }
