}

int IsPointerReassignedOnPath(string pointerName, int pointerScope, int afterToken, int beforeToken, int currentBranch, int currentArm, array<string> assignmentNames, array<int> assignmentScopes, array<int> assignmentTokens, array<int> assignmentBranches, array<int> assignmentArms, array<int> branchIfTokens, array<bool> branchHasElse, array<int> branchParents, array<int> branchParentArms)
{
    Length(assignmentNames)
    int assignmentCount = Length
    for(assignmentIndex, 0, assignmentCount)
    {
        if(assignmentNames[assignmentIndex] == pointerName && assignmentScopes[assignmentIndex] == pointerScope && assignmentTokens[assignmentIndex] > afterToken && assignmentTokens[assignmentIndex] < beforeToken)
        {
            if(assignmentBranches[assignmentIndex] == 0)
            {
                return 1
            }
            IsBranchContextWithin(currentBranch, currentArm, assignmentBranches[assignmentIndex], assignmentArms[assignmentIndex], branchParents, branchParentArms)
            int assignmentOnCurrentPath = IsBranchContextWithin
            if(assignmentOnCurrentPath == 1)
            {
                return 1
            }
        }
    }

    Length(branchHasElse)
    int branchCount = Length
    for(branchIndex, 0, branchCount)
    {
        if(branchParents[branchIndex] == 0 && branchHasElse[branchIndex] && branchIfTokens[branchIndex] > afterToken && branchIfTokens[branchIndex] < beforeToken)
        {
            bool assignedThen = false
            bool assignedElse = false
            for(assignmentIndex, 0, assignmentCount)
            {
                if(assignmentNames[assignmentIndex] == pointerName && assignmentScopes[assignmentIndex] == pointerScope && assignmentTokens[assignmentIndex] > afterToken && assignmentTokens[assignmentIndex] < beforeToken && assignmentBranches[assignmentIndex] == branchIndex + 1)
                {
                    if(assignmentArms[assignmentIndex] == 1)
                    {
                        assignedThen = true
                    }
                    else if(assignmentArms[assignmentIndex] == 2)
                    {
                        assignedElse = true
                    }
                }
            }
            if(assignedThen && assignedElse)
            {
                return 1
            }
        }
    }
    return 0
}

int GetLexicalScopeDistance(int currentScope, int declarationScope, array<int> lexicalScopeParents)
{
    int scope = currentScope
    int distance = 0
    while(scope > 0)
    {
        if(scope == declarationScope)
        {
            return distance
        }
        scope = lexicalScopeParents[scope - 1]
        distance = distance + 1
    }
    return -1
}

int GetNearestAllocationDistance(string pointerName, int functionScope, int beforeToken, int currentLexicalScope, int maximumDistance, array<string> allocationNames, array<int> allocationFunctionScopes, array<int> allocationTokens, array<int> allocationLexicalScopes, array<int> lexicalScopeParents)
{
    int nearestDistance = maximumDistance
    Length(allocationNames)
    int candidateCount = Length
    for(candidateIndex, 0, candidateCount)
    {
        if(allocationNames[candidateIndex] == pointerName && allocationFunctionScopes[candidateIndex] == functionScope && allocationTokens[candidateIndex] < beforeToken)
        {
            GetLexicalScopeDistance(currentLexicalScope, allocationLexicalScopes[candidateIndex], lexicalScopeParents)
            int candidateDistance = GetLexicalScopeDistance
            if(candidateDistance >= 0 && candidateDistance < nearestDistance)
            {
                nearestDistance = candidateDistance
            }
        }
    }
    return nearestDistance
}

int GetNearestAliasDistance(string aliasName, int functionScope, int currentLexicalScope, int maximumDistance, array<string> aliasNames, array<int> aliasFunctionScopes, array<int> aliasLexicalScopes, array<bool> aliasActive, array<int> lexicalScopeParents)
{
    int nearestDistance = maximumDistance
    Length(aliasNames)
